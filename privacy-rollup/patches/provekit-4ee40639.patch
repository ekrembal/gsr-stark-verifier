diff --git a/provekit/common/src/utils/sumcheck.rs b/provekit/common/src/utils/sumcheck.rs
index 17a7c429..64856021 100644
--- a/provekit/common/src/utils/sumcheck.rs
+++ b/provekit/common/src/utils/sumcheck.rs
@@ -242,3 +242,44 @@ pub fn calculate_external_row_of_r1cs_matrices(
     let (at, bt, ct) = transpose_r1cs_matrices(r1cs);
     multiply_transposed_by_eq_alpha(&at, &bt, &ct, alpha, r1cs)
 }
+
+/// Computes `eq(alpha, ·) * [A, B, C]` by a sequential row-major scatter, without
+/// transposing. Unit coefficients `±1` are applied as additions.
+#[instrument(skip_all)]
+pub fn calculate_external_row_by_scatter(
+    alpha: &[FieldElement],
+    r1cs: &R1CS,
+) -> [Vec<FieldElement>; 3] {
+    let eq_alpha =
+        calculate_evaluations_over_boolean_hypercube_for_eq(alpha, r1cs.num_constraints());
+    let values = r1cs.interner.values();
+    let one = FieldElement::one();
+    let minus_one = -one;
+    let kind: Vec<u8> = values
+        .iter()
+        .map(|v| {
+            if *v == one {
+                1
+            } else if *v == minus_one {
+                2
+            } else {
+                0
+            }
+        })
+        .collect();
+    let scatter = |m: &SparseMatrix| {
+        let mut out = vec![FieldElement::zero(); m.num_cols];
+        for (row, e) in eq_alpha.iter().enumerate().take(m.num_rows) {
+            for (col, v) in m.iter_row(row) {
+                let i = v.index();
+                match kind[i] {
+                    1 => out[col] += e,
+                    2 => out[col] -= e,
+                    _ => out[col] += values[i] * e,
+                }
+            }
+        }
+        out
+    };
+    [scatter(&r1cs.a), scatter(&r1cs.b), scatter(&r1cs.c)]
+}
