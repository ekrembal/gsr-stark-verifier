-/// Computes `eq(alpha, ·) * [A, B, C]` by a sequential row-major scatter, without
-/// transposing. Unit coefficients `±1` are applied as additions.
+/// Computes `eq(alpha, ·) * [A, B, C]` in row order. General coefficient
+/// products are cached for one row across all three matrices. Each output
+/// column keeps the original contribution order; no transcript data changes.
 #[instrument(skip_all)]
-pub fn calculate_external_row_by_scatter(
-    alpha: &[FieldElement],
-    r1cs: &R1CS,
-) -> [Vec<FieldElement>; 3] {
-    let eq_alpha =
-        calculate_evaluations_over_boolean_hypercube_for_eq(alpha, r1cs.num_constraints());
+pub fn calculate_external_row_by_scatter(alpha: &[FieldElement], r1cs: &R1CS) -> [Vec<FieldElement>; 3] {
+    let eq_alpha = calculate_evaluations_over_boolean_hypercube_for_eq(alpha, r1cs.num_constraints());
     let values = r1cs.interner.values();
     let one = FieldElement::one();
-    let minus_one = -one;
+    let two = one + one;
+    let three = two + one;
     let kind: Vec<u8> = values
         .iter()
         .map(|v| {
             if *v == one {
                 1
-            } else if *v == minus_one {
+            } else if *v == -one {
                 2
+            } else if v.is_zero() {
+                3
+            } else if *v == two {
+                4
+            } else if *v == -two {
+                5
+            } else if *v == three {
+                6
+            } else if *v == -three {
+                7
             } else {
                 0
             }
         })
         .collect();
-    let scatter = |m: &SparseMatrix| {
-        let mut out = vec![FieldElement::zero(); m.num_cols];
-        for (row, e) in eq_alpha.iter().enumerate().take(m.num_rows) {
-            for (col, v) in m.iter_row(row) {
-                let i = v.index();
+    let matrices = [&r1cs.a, &r1cs.b, &r1cs.c];
+    let mut out = matrices.map(|m| vec![FieldElement::zero(); m.num_cols]);
+    let mut cache = vec![(usize::MAX, FieldElement::zero()); values.len()];
+    for (row, e) in eq_alpha.iter().enumerate() {
+        for (matrix, output) in matrices.iter().zip(&mut out) {
+            if row >= matrix.num_rows {
+                continue;
+            }
+            for (col, coefficient) in matrix.iter_row(row) {
+                let i = coefficient.index();
                 match kind[i] {
-                    1 => out[col] += e,
-                    2 => out[col] -= e,
-                    _ => out[col] += values[i] * e,
+                    1 => output[col] += e,
+                    2 => output[col] -= e,
+                    3 => {}
+                    _ => {
+                        let (tag, product) = &mut cache[i];
+                        if *tag != row {
+                            *product = match kind[i] {
+                                4 => *e + e,
+                                5 => -(*e + e),
+                                6 => (*e + e) + e,
+                                7 => -((*e + e) + e),
+                                _ => values[i] * e,
