+/// Integer entries of the compiler's exact external 4x4 matrix.
+#[cfg_attr(not(any(test, feature = "linear-dot4")), allow(dead_code))]
+const EXTERNAL: [[u64; 4]; 4] = [[5, 7, 1, 3], [4, 6, 1, 1], [1, 3, 5, 7], [1, 1, 4, 6]];
+
+/// The two Poseidon2 linear layers as explicit row-major matrices. The internal
+/// layer is diag(DIAGONAL) + 11^T.
+#[cfg_attr(not(any(test, feature = "linear-dot4")), allow(dead_code))]
+struct LinearLayers {
+    external: [[FieldElement; 4]; 4],
+    internal: [[FieldElement; 4]; 4],
+}
+
+#[cfg_attr(not(any(test, feature = "linear-dot4")), allow(dead_code))]
+impl LinearLayers {
+    fn new() -> Self {
+        let one = FieldElement::from(1u64);
+        Self {
+            external: EXTERNAL.map(|row| row.map(FieldElement::from)),
+            internal: core::array::from_fn(|i| {
+                core::array::from_fn(|j| if i == j { DIAGONAL[i] + one } else { one })
+            }),
+        }
+    }
+}
+
+/// Each row is one 4-term dot product; the optional guest BigInt2 backend
+/// checks it with one canonical modular reduction.
+#[cfg_attr(not(any(test, feature = "linear-dot4")), allow(dead_code))]
+#[inline]
+fn apply_linear(matrix: &[[FieldElement; 4]; 4], state: [FieldElement; 4]) -> [FieldElement; 4] {
+    if state.iter().all(|x| *x == FieldElement::ZERO) {
+        return state;
+    }
+    core::array::from_fn(|i| FieldElement::sum_of_products(&matrix[i], &state))
+}
+
+/// External layer: explicit dot rows with `linear-dot4`, additions otherwise.
+#[inline]
+fn external_layer(_layers: &LinearLayers, state: [FieldElement; 4]) -> [FieldElement; 4] {
+    #[cfg(feature = "linear-dot4")]
+    return apply_linear(&_layers.external, state);
+    #[cfg(not(feature = "linear-dot4"))]
+    external_forward(state)
+}
+
+/// Internal layer: explicit dot rows with `linear-dot4`, diagonal plus sum otherwise.
+#[inline]
+fn internal_layer(_layers: &LinearLayers, state: [FieldElement; 4]) -> [FieldElement; 4] {
+    #[cfg(feature = "linear-dot4")]
+    return apply_linear(&_layers.internal, state);
+    #[cfg(not(feature = "linear-dot4"))]
+    {
+        let sum: FieldElement = state.iter().copied().sum();
+        core::array::from_fn(|lane| nonzero_product(DIAGONAL[lane], state[lane]) + sum)
+    }
+}
