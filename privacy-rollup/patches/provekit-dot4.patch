+#[cfg(test)]
+mod tests {
+    use super::*;
+    use ark_ff::UniformRand;
+
+    #[test]
+    fn linear_layers_match_poseidon2_round_maps() {
+        let mut rng = ark_std::test_rng();
+        let layers = LinearLayers::new();
+        let mut cases = vec![[FieldElement::ZERO; 4], [-FieldElement::from(1u64); 4]];
+        cases.push([FieldElement::ZERO, FieldElement::from(1u64), FieldElement::ZERO, -FieldElement::from(1u64)]);
+        cases.extend((0..256).map(|_| core::array::from_fn(|_| FieldElement::rand(&mut rng))));
+        for state in cases {
+            assert_eq!(apply_linear(&layers.external, state), external_forward(state));
+            let sum: FieldElement = state.iter().copied().sum();
+            let internal: [FieldElement; 4] = core::array::from_fn(|lane| DIAGONAL[lane] * state[lane] + sum);
+            assert_eq!(apply_linear(&layers.internal, state), internal);
+            assert_eq!(external_layer(&layers, state), external_forward(state));
+            assert_eq!(internal_layer(&layers, state), internal);
+        }
+    }
