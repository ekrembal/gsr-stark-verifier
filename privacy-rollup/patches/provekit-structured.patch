+        ];
+        anyhow::ensure!(Sha256::digest(bytes).as_slice() == KEY_HASH, "join-split verifier key");
+        Ok(Self { scheme: postcard::from_bytes(include_bytes!("joinsplit_whir.pc")).context("fixed WHIR configuration encoding")? })
+    }
+
+    #[instrument(skip_all)]
+    pub fn verify_ref(&self, proof: &NoirProof) -> Result<()> {
+        provekit_common::register_ntt();
+        self.scheme.verify_with_matrix(
+            &proof.whir_r1cs_proof, &proof.public_inputs, None,
+        )
+    }
+}
