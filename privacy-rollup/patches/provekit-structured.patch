+/// A reusable verifier bound to the exact privacy-rollup JoinSplit key.
+/// The private configuration cannot be replaced after the hash check.
+pub struct FixedJoinSplitVerifier {
+    scheme: WhirR1CSScheme,
+}
+
+impl FixedJoinSplitVerifier {
+    /// Check every input byte before loading the exact pre-exported configuration.
+    pub fn from_postcard(bytes: &[u8]) -> Result<Self> {
+        use sha2::{Digest, Sha256};
+        const KEY_HASH: [u8; 32] = [
+            0xbc,0x13,0x84,0x08,0x9b,0x1d,0xc1,0x65,0x4e,0x61,0x56,0x10,0x89,0x52,0x3a,0xe5,
