+//! Exact linear evaluator for the pinned privacy-rollup JoinSplit matrices.
+//!
+//! This is a matrix operation, not a proof verifier. The caller must bind the
+//! supplied R1CS to VK SHA-256 bc1384089b1dc1654e61561089523ae521d2cf9b664589ec1e965108b4e2a183.
+//! The safe verifier entry point checks the complete encoded VK before using it.
+//! S-box outputs remain independent witness columns; only linear forms change.
+use super::sumcheck::{calculate_evaluations_over_boolean_hypercube_for_eq, scatter_selected_rows};
+use crate::{FieldElement, R1CS};
+use ark_ff::{AdditiveGroup, Field};
+
+struct Block {
+    row: usize,
+    y2: [u16; 88],
+    y4: [u16; 88],
+    y5: [u16; 88],
+    outputs: [u16; 4],
+    initial: [&'static [(u16, FieldElement)]; 4],
+}
+include!("structured_matrix_data.rs");
+
+/// Transpose of the compiler's exact external 4x4 matrix, using only additions.
+fn external_transpose([a, b, c, d]: [FieldElement; 4]) -> [FieldElement; 4] {
+    let u = a + b;
+    let v = c + d;
+    let u2 = u + u;
+    let u4 = u2 + u2;
+    let u6 = u4 + u2;
+    let v2 = v + v;
+    let v4 = v2 + v2;
+    let v6 = v4 + v2;
+    [
+        u4 + a + v,
+        u6 + a + v + (c + c),
+        u + v4 + c,
+        u + (a + a) + v6 + c,
+    ]
+}
+
+fn form_weight(eq: &[FieldElement], row: usize, sbox: usize, matrix: usize) -> FieldElement {
+    let first = eq[row + 3 * sbox];
+    if matrix == 0 {
+        first
+    } else {
+        first + eq[row + 3 * sbox + 2]
+    }
+}
+
+/// Return the same three column vectors as the generic row-major scatter.
+#[tracing::instrument(skip_all)]
+pub fn evaluate(alpha: &[FieldElement], r1cs: &R1CS) -> [Vec<FieldElement>; 3] {
+    assert_eq!(r1cs.num_constraints(), 38819);
+    assert_eq!(r1cs.num_witnesses(), 51805);
+    let eq = calculate_evaluations_over_boolean_hypercube_for_eq(alpha, r1cs.num_constraints());
+    evaluate_with_eq(&eq, r1cs)
+}
+
+/// Public for differential matrix tests with arbitrary row weights.
+pub fn evaluate_with_eq(eq: &[FieldElement], r1cs: &R1CS) -> [Vec<FieldElement>; 3] {
+    assert_eq!(r1cs.num_constraints(), 38819);
+    assert_eq!(r1cs.num_witnesses(), 51805);
+    assert!(eq.len() >= r1cs.num_constraints());
+    let mut next_block = 0;
+    let out = scatter_selected_rows(eq, r1cs, |row| {
+        while next_block < BLOCKS.len() && row >= BLOCKS[next_block].row + 268 {
+            next_block += 1;
+        }
+        next_block == BLOCKS.len() || row < BLOCKS[next_block].row
+    });
+    reverse_blocks(eq, out)
+}
+
+/// Matrix data compiled from the exact hash-bound VK; avoids decoding its
+/// expanded sparse matrices. All residual rows are literal generated entries.
+#[tracing::instrument(skip_all)]
+pub fn evaluate_fixed(alpha: &[FieldElement]) -> [Vec<FieldElement>; 3] {
+    let eq = calculate_evaluations_over_boolean_hypercube_for_eq(alpha, 38819);
+    evaluate_fixed_with_eq(&eq)
+}
+
+pub fn evaluate_fixed_with_eq(eq: &[FieldElement]) -> [Vec<FieldElement>; 3] {
+    assert!(eq.len() >= 38819);
+    let mut out = core::array::from_fn(|_| vec![FieldElement::ZERO; 51805]);
+    for &(row, matrices) in RESIDUAL_ROWS {
+        let weight = eq[row as usize];
+        for matrix in 0..3 {
+            for &(column, coefficient) in matrices[matrix] {
+                out[matrix][column as usize] += coefficient * weight;
+            }
+        }
+    }
+    reverse_blocks(eq, out)
+}
+
+fn reverse_blocks(eq: &[FieldElement], mut out: [Vec<FieldElement>; 3]) -> [Vec<FieldElement>; 3] {
+    // Every block uses the same round constants. Accumulate their weights
+    // before multiplying, preserving exact field sums while sharing products.
+    let mut rc_weights = [[FieldElement::ZERO; 88]; 2];
+    for block in &BLOCKS {
+        let row = block.row;
+        for j in 0..88 {
+            let e0 = eq[row + 3 * j];
+            let e1 = eq[row + 3 * j + 1];
+            let e2 = eq[row + 3 * j + 2];
+            let y2 = block.y2[j] as usize;
+            let y4 = block.y4[j] as usize;
+            let y5 = block.y5[j] as usize;
+            out[0][y2] += e1;
+            out[0][y4] += e2;
+            out[1][y2] += e1;
+            out[2][y2] += e0;
+            out[2][y4] += e1;
+            out[2][y5] += e2;
+        }
+        for lane in 0..4 {
+            out[1][0] += eq[row + 264 + lane];
+            out[2][block.outputs[lane] as usize] += eq[row + 264 + lane];
+        }
+        for matrix in 0..2 {
+            let mut adjoint: [FieldElement; 4] = core::array::from_fn(|lane| {
+                if matrix == 0 {
+                    eq[row + 264 + lane]
+                } else {
+                    FieldElement::ZERO
+                }
+            });
+            // Last four full rounds, in reverse.
+            for group in (0..4).rev() {
+                let start = 72 + 4 * group;
+                let products = external_transpose(adjoint);
+                for lane in 0..4 {
+                    out[matrix][block.y5[start + lane] as usize] += products[lane];
+                    adjoint[lane] = form_weight(eq, row, start + lane, matrix);
+                    rc_weights[matrix][start + lane] += adjoint[lane];
+                }
+            }
+            // Internal mix is diag(d)+11^T, hence symmetric. Lane zero was
+            // replaced by an independent S-box output, so it ends at that column.
+            for j in (16..72).rev() {
+                let sum = adjoint.iter().copied().sum::<FieldElement>();
+                for lane in 0..4 {
+                    adjoint[lane] = DIAGONAL[lane] * adjoint[lane] + sum;
+                }
+                out[matrix][block.y5[j] as usize] += adjoint[0];
+                adjoint[0] = form_weight(eq, row, j, matrix);
+                rc_weights[matrix][j] += adjoint[0];
+            }
+            // First four full rounds. The first four literal linear forms
+            // include the initial external mix and the first round constants.
+            for group in (0..4).rev() {
+                let start = 4 * group;
+                let products = external_transpose(adjoint);
+                for lane in 0..4 {
+                    out[matrix][block.y5[start + lane] as usize] += products[lane];
+                    adjoint[lane] = form_weight(eq, row, start + lane, matrix);
+                    if group == 0 {
+                        for &(column, coefficient) in block.initial[lane] {
+                            out[matrix][column as usize] += coefficient * adjoint[lane];
+                        }
+                    } else {
+                        rc_weights[matrix][start + lane] += adjoint[lane];
+                    }
+                }
+            }
+        }
+    }
+    for matrix in 0..2 {
+        for j in 4..88 {
+            out[matrix][0] += ROUND_CONSTANTS[j] * rc_weights[matrix][j];
+        }
+    }
+    out
+}
+
+/// Forward external linear map; this never evaluates a nonlinear S-box.
+fn external_forward([a, b, c, d]: [FieldElement; 4]) -> [FieldElement; 4] {
+    let u = a + b;
+    let v = c + d;
+    let u2 = u + u;
+    let u4 = u2 + u2;
+    let v2 = v + v;
+    let v4 = v2 + v2;
+    let p = u4 + (b + b) + v;
+    let q = u + v4 + (d + d);
+    [p + a + b + (d + d), p, q + (b + b) + c + d, q]
+}
+
+// Values outside the selected commitment are exactly zero. Avoiding products
+// by those zeros is public-data specialization, not a witness assumption.
+#[inline]
+fn nonzero_product(a: FieldElement, b: FieldElement) -> FieldElement {
+    if b == FieldElement::ZERO {
+        FieldElement::ZERO
+    } else {
+        a * b
+    }
+}
+
+/// Fixed-size buffering changes only the grouping of a field dot product.
+/// The generic field backend is the reference; the optional guest BigInt2
+/// backend checks all 32 products with one canonical modular reduction.
+struct BatchedDot {
+    lhs: [FieldElement; 32],
+    rhs: [FieldElement; 32],
+    len: usize,
+    total: FieldElement,
+}
+
+impl BatchedDot {
+    fn new() -> Self {
+        Self { lhs: [FieldElement::ZERO; 32], rhs: [FieldElement::ZERO; 32], len: 0, total: FieldElement::ZERO }
+    }
+
+    fn push(&mut self, a: FieldElement, b: FieldElement) {
+        if b == FieldElement::ZERO { return; }
+        self.lhs[self.len] = a;
+        self.rhs[self.len] = b;
+        self.len += 1;
+        if self.len == 32 {
+            self.total += FieldElement::sum_of_products(&self.lhs, &self.rhs);
+            self.len = 0;
+        }
+    }
+
+    fn finish(mut self) -> FieldElement {
+        if self.len != 0 {
+            // Old rhs entries are harmless only after zeroing each unused lhs.
+            self.lhs[self.len..].fill(FieldElement::ZERO);
+            self.total += FieldElement::sum_of_products(&self.lhs, &self.rhs);
+        }
+        self.total
+    }
+}
+
+/// Evaluate all three matrix bilinear forms directly. `columns[i]` is the
+/// arbitrary value assigned to independent witness column `offset+i`.
+/// S-box output columns are read independently, including for invalid witnesses.
+#[tracing::instrument(skip_all)]
+pub fn evaluate_bilinear(
+    eq: &[FieldElement],
+    columns: &[FieldElement],
+    offset: usize,
+) -> [FieldElement; 3] {
+    assert!(eq.len() >= 38819);
+    assert!(offset <= 51805 && columns.len() <= 51805 - offset);
+    let column = |c: u16| {
+        let c = c as usize;
+        if c >= offset && c - offset < columns.len() {
+            columns[c - offset]
+        } else {
+            FieldElement::ZERO
+        }
+    };
+    let constant = column(0);
+    let constants = ROUND_CONSTANTS.map(|rc| nonzero_product(rc, constant));
+    let mut out: [BatchedDot; 3] = core::array::from_fn(|_| BatchedDot::new());
+    let mut common = BatchedDot::new();
+    for &(row, matrices) in RESIDUAL_ROWS {
+        for matrix in 0..3 {
+            let value: FieldElement = matrices[matrix]
+                .iter()
+                .map(|&(c, coefficient)| nonzero_product(coefficient, column(c)))
+                .sum();
+            out[matrix].push(eq[row as usize], value);
+        }
+    }
+    for block in &BLOCKS {
+        let mut state: [FieldElement; 4] = core::array::from_fn(|lane| {
+            block.initial[lane]
+                .iter()
+                .map(|&(c, coefficient)| nonzero_product(coefficient, column(c)))
+                .sum()
+        });
+        let mut sbox = |j: usize, form: FieldElement| {
+            let e = &eq[block.row + 3 * j..block.row + 3 * j + 3];
+            let y2 = column(block.y2[j]);
+            let y4 = column(block.y4[j]);
+            let y5 = column(block.y5[j]);
+            common.push(e[0], form);
+            common.push(e[1], y2);
+            out[0].push(e[2], y4);
+            out[1].push(e[2], form);
+            out[2].push(e[0], y2);
+            out[2].push(e[1], y4);
+            out[2].push(e[2], y5);
+            y5
+        };
+        for group in 0..4 {
+            for lane in 0..4 {
+                let j = 4 * group + lane;
+                if group > 0 {
+                    state[lane] += constants[j];
+                }
+                state[lane] = sbox(j, state[lane]);
+            }
+            state = external_forward(state);
+        }
+        for j in 16..72 {
+            state[0] += constants[j];
+            state[0] = sbox(j, state[0]);
+            let sum: FieldElement = state.iter().copied().sum();
+            for lane in 0..4 {
+                state[lane] = nonzero_product(DIAGONAL[lane], state[lane]) + sum;
+            }
+        }
+        for group in 0..4 {
+            for lane in 0..4 {
+                let j = 72 + 4 * group + lane;
+                state[lane] += constants[j];
+                state[lane] = sbox(j, state[lane]);
+            }
+            state = external_forward(state);
+        }
+        for lane in 0..4 {
+            let e = eq[block.row + 264 + lane];
+            out[0].push(e, state[lane]);
+            out[1].push(e, constant);
+            out[2].push(e, column(block.outputs[lane]));
+        }
+    }
+    let common = common.finish();
+    let [a, b, c] = out.map(BatchedDot::finish);
+    [a + common, b + common, c]
+}
+
+use std::sync::{Arc, Mutex};
+use whir::algebra::linear_form::LinearForm;
+
+struct FixedCovectorShared {
+    rows: Arc<Vec<FieldElement>>,
+    offset: usize,
+    len: usize,
+    domain_size: usize,
+    // A and B and C share the same point within one commitment. Each commitment
+    // owns a separate cache; a changed point always recomputes the exact value.
+    cache: Mutex<Option<(Vec<FieldElement>, [FieldElement; 3])>>,
+}
+
+/// Lazy matrix weight for the exact pinned JoinSplit VK only.
+/// The hash-bound verifier constructs this after the same sumcheck transcript.
+pub struct FixedMatrixCovector {
+    shared: Arc<FixedCovectorShared>,
+    matrix: usize,
+}
+
+impl FixedMatrixCovector {
+    pub fn new_group(
+        rows: Arc<Vec<FieldElement>>,
+        offset: usize,
+        len: usize,
+        domain_size: usize,
+    ) -> [Self; 3] {
+        assert_eq!(rows.len(), 38819);
+        assert!(domain_size.is_power_of_two() && len > 0 && len <= domain_size);
+        assert!(offset <= 51805 && len <= 51805 - offset);
+        let shared = Arc::new(FixedCovectorShared {
+            rows,
+            offset,
+            len,
+            domain_size,
+            cache: Mutex::new(None),
+        });
+        core::array::from_fn(|matrix| Self {
+            shared: shared.clone(),
+            matrix,
+        })
+    }
+}
+
+impl LinearForm<FieldElement> for FixedMatrixCovector {
+    fn size(&self) -> usize {
+        self.shared.domain_size
+    }
+
+    #[tracing::instrument(skip_all, name = "fixed_matrix_mle")]
+    fn mle_evaluate(&self, point: &[FieldElement]) -> FieldElement {
+        let dimension = self.shared.domain_size.trailing_zeros() as usize;
+        assert!(point.len() >= dimension);
+        let leading = point.len()-dimension;
+        let mut cache = self
+            .shared
+            .cache
+            .lock()
+            .expect("fixed matrix cache poisoned");
+        if let Some((old_point, values)) = cache.as_ref() {
+            if old_point == point {
+                return values[self.matrix];
+            }
+        }
+        // Index zero is the start of this commitment, not global witness zero.
+        // In particular the second commitment uses column index c-5530.
+        // LinearForm also permits extra leading coordinates. Factor those
+        // zeros out explicitly, avoiding shifts by an unbounded point length.
+        let columns = calculate_evaluations_over_boolean_hypercube_for_eq(&point[leading..], self.shared.len);
+        let mut values = evaluate_bilinear(&self.shared.rows, &columns, self.shared.offset);
+        if leading > 0 {
+            let factor: FieldElement = point[..leading].iter().map(|x| FieldElement::from(1u64)-x).product();
+            for value in &mut values { *value *= factor; }
+        }
+        *cache = Some((point.to_vec(), values));
+        values[self.matrix]
+    }
+
+    fn accumulate(&self, accumulator: &mut [FieldElement], scalar: FieldElement) {
+        assert_eq!(accumulator.len(), self.shared.domain_size);
+        // Required by the trait, although the verifier does not call it.
+        let vectors = evaluate_fixed_with_eq(&self.shared.rows);
+        let weights =
+            &vectors[self.matrix][self.shared.offset..self.shared.offset + self.shared.len];
+        for (dest, value) in accumulator.iter_mut().zip(weights) {
+            *dest += scalar * value;
+        }
+    }
+}
