+/// Same MSB-first equality table, using in-place breadth expansion. Retaining
+/// ceil(num_entries / subtree_size) prefixes is essential for truncated tables.
+/// Public for differential testing; native client code keeps the parallel path.
+pub fn calculate_eq_iterative(r: &[FieldElement], num_entries: usize) -> Vec<FieldElement> {
+    assert!(r.len() < usize::BITS as usize);
+    let mut subtree_size = 1usize << r.len();
+    assert!(num_entries <= subtree_size);
+    let mut result = vec![FieldElement::zero(); num_entries];
+    if num_entries == 0 { return result; }
+    result[0] = FieldElement::one();
+    let mut prefixes = 1;
+    for &x in r {
+        subtree_size /= 2;
+        let next = num_entries.div_ceil(subtree_size);
+        // Descending order prevents overwriting an unexpanded parent.
+        for parent in (0..prefixes).rev() {
+            let scalar = result[parent];
+            let right = scalar*x;
+            result[2*parent] = scalar-right;
+            if 2*parent+1 < next { result[2*parent+1] = right; }
+        }
+        prefixes = next;
+    }
+    result
