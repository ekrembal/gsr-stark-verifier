+#!/usr/bin/env python3
+"""Generate a prover-only multi-cycle evaluator of the pinned recursion constraints.
+
+No AIR, constraint coefficient, field representation, or verifier is changed.
+Each raw matrix read retains its original masked index expression separately
+for each lane. Generated output belongs in OUT_DIR, not in the source tree.
+Python assertions must be enabled.
+"""
+if not __debug__:
+ raise SystemExit('run the generator without Python optimization')
+from pathlib import Path
+import argparse, hashlib, json, re
+parser=argparse.ArgumentParser(description=__doc__)
+parser.add_argument('src',type=Path)
+parser.add_argument('sys_headers',type=Path)
+parser.add_argument('out',type=Path)
+options=parser.parse_args()
+src,sys_headers,out=options.src,options.sys_headers,options.out
+out.mkdir(parents=True,exist_ok=True)
+
+# Fail closed on a different circuit/field source. Changing these hashes
+# requires re-review and differential validation.
+EXPECTED={'poly_fp.cpp':'e93eaae8f0bd935bc6d227f30df3966106d78619ae810c7739be9b909679ea01','fp.h':'1f1cb927854060d06ed6bb53d52978de9cd89c711338ead0de9b805cb18633ad','fpext.h':'194bf07cb14abcead498da69c62ff8464f05139fd75e8271d11c703be6471213'}
+for name,expected in EXPECTED.items():
+ p=(sys_headers if name.endswith('.h') else src)/name
+ if hashlib.sha256(p.read_bytes()).hexdigest()!=expected:
+  raise SystemExit('unsupported scalar source digest: '+str(p))
+text=(src/'poly_fp.cpp').read_text()
+decl='FpExt poly_fp(size_t cycle, size_t steps, FpExt* poly_mix, Fp** args)'
+assert text.count(decl)==2
+# The single function body is straight-line code: no loops, branches, scratch
+# arrays or calls, so lane-wise evaluation is the scalar code per lane.
+body=text.split(decl+' {\n',1)[1]
+assert not re.search(r'\b(for|while|if|switch|goto)\b|\bFp \w+\[|\bFpExt \w+\[',body)
+counts={'masked':0,'uniform':0}
+masked=r'(\d+) \* steps \+ \(\(cycle - kInvRate \* (\d+)\) & mask\)'
+def load(m):
+ ptr,index=m.groups()
+ if re.fullmatch(masked,index):
+  counts['masked']+=1
+  index=index.replace('(cycle - ','((cycle + lane) - ')
+  return f'Fp::load({ptr}, [&](size_t lane) {{ return {index}; }})'
+ assert re.fullmatch(r'\d+',index),index
+ counts['uniform']+=1
+ return f'Fp::broadcast({ptr}[{index}])'
+text=re.sub(r'(args\[[0-4]\])\[([^\[\]\n]+)\]',load,text)
+assert 'args[' not in re.sub(r'Fp::(load|broadcast)\(args\[[0-4]\]','',text)
+text=text.replace(decl,'FpExt poly_fp(size_t cycle, size_t steps, UniformMix poly_mix, const ScalarFp* const* args)')
+text=text.replace('#include "fp.h"\n#include "fpext.h"','#include "packed_fpext.h"')
+text=text.replace('namespace risc0::circuit::recursion','namespace gsr_recursion_batch')
+text=text.replace('constexpr Fp ','const Fp ').replace('constexpr FpExt ','const FpExt ')
+text=text.replace('constexpr size_t kInvRate','static constexpr size_t kInvRate')
+(out/'packed_poly_fp.cpp').write_text(text)
+ext=(sys_headers/'fpext.h').read_text()
+ext=ext.replace('#include "fp.h"','#include "packed_fp.h"\n#include "fpext.h"')
+ext=ext.replace('namespace risc0 {','namespace gsr_recursion_batch {').replace('constexpr ','')
+ext+='''\nnamespace gsr_recursion_batch {
+struct UniformMix {
+  const risc0::FpExt* ptr;
+  FpExt operator[](size_t i) const {
+    return FpExt(Fp::broadcast(ptr[i].elems[0]), Fp::broadcast(ptr[i].elems[1]),
+                 Fp::broadcast(ptr[i].elems[2]), Fp::broadcast(ptr[i].elems[3]));
+  }
+};
+FpExt poly_fp(size_t, size_t, UniformMix, const ScalarFp* const*);
+}\n'''
+(out/'packed_fpext.h').write_text(ext)
+(out/'generation.json').write_text(json.dumps({'source_sha256':hashlib.sha256((src/'poly_fp.cpp').read_bytes()).hexdigest(),'transformed_loads':counts},indent=2)+'\n')
+assert counts=={'masked':669,'uniform':52},counts
+print('input loads',counts)
