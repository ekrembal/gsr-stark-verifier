+//! Optional host-only BabyBear NTT and zk_shift kernels.
+//!
+//! These perform the same butterflies as [crate::core::ntt] in the same
+//! per-element order, with the same word-level add, sub and Montgomery
+//! multiplication formulas as `baby_bear`, so results are bit-identical for
+//! canonical inputs (every word below P). Callers keep the generic path for
+//! any other input, which retains its `INVALID` checks. Twiddles are read from cached tables instead of being
+//! accumulated serially, which removes the loop-carried multiply and lets the
+//! compiler vectorize the inner loops.
+use std::sync::OnceLock;
+
+use risc0_core::field::{
+    baby_bear::{BabyBearElem, P},
+    Elem, RootsOfUnity,
+};
+
+use crate::core::ntt::bit_rev_32;
+
+const M: u32 = 0x88000001;
+/// Subtrees at most this many levels deep are transformed level by level.
+const ITERATIVE_LEVELS: usize = 11;
+const MAX_LEVEL: usize = 27;
+
+#[inline(always)]
+fn add(lhs: u32, rhs: u32) -> u32 {
+    let x = lhs.wrapping_add(rhs);
+    if x >= P {
+        x - P
+    } else {
+        x
+    }
+}
+
+#[inline(always)]
+fn sub(lhs: u32, rhs: u32) -> u32 {
+    let x = lhs.wrapping_sub(rhs);
+    if x > P {
+        x.wrapping_add(P)
+    } else {
+        x
+    }
+}
+
+#[inline(always)]
+fn mul(lhs: u32, rhs: u32) -> u32 {
+    let mut o64 = u64::from(lhs).wrapping_mul(u64::from(rhs));
+    let low = 0u32.wrapping_sub(o64 as u32);
+    let red = M.wrapping_mul(low);
+    o64 = o64.wrapping_add(u64::from(red).wrapping_mul(u64::from(P)));
+    let ret = (o64 >> 32) as u32;
+    if ret >= P {
+        ret - P
+    } else {
+        ret
+    }
+}
+
+/// `step^i` for `i < 2^(level-1)`, in Montgomery form.
+fn powers(step: BabyBearElem, level: usize) -> Vec<u32> {
+    let half = 1usize << (level - 1);
+    let mut out = Vec::with_capacity(half);
+    let mut cur = BabyBearElem::ONE;
+    for _ in 0..half {
+        out.push(cur.as_u32_montgomery());
+        cur *= step;
+    }
+    out
+}
+
+fn twiddles(forward: bool, level: usize) -> &'static [u32] {
+    static FWD: [OnceLock<Vec<u32>>; MAX_LEVEL + 1] = [const { OnceLock::new() }; MAX_LEVEL + 1];
+    static REV: [OnceLock<Vec<u32>>; MAX_LEVEL + 1] = [const { OnceLock::new() }; MAX_LEVEL + 1];
+    assert!((1..=MAX_LEVEL).contains(&level));
+    if forward {
+        FWD[level].get_or_init(|| powers(BabyBearElem::ROU_FWD[level], level))
+    } else {
+        REV[level].get_or_init(|| powers(BabyBearElem::ROU_REV[level], level))
+    }
+}
+
+#[inline(always)]
+fn fwd_combine(io: &mut [u32], tw: &[u32]) {
+    let (lo, hi) = io.split_at_mut(tw.len());
+    for ((a, b), w) in lo.iter_mut().zip(hi.iter_mut()).zip(tw) {
+        let x = *a;
+        let y = mul(*b, *w);
+        *a = add(x, y);
+        *b = sub(x, y);
+    }
+}
+
+#[inline(always)]
+fn rev_combine(io: &mut [u32], tw: &[u32]) {
+    let (lo, hi) = io.split_at_mut(tw.len());
+    for ((a, b), w) in lo.iter_mut().zip(hi.iter_mut()).zip(tw) {
+        let x = *a;
+        let y = *b;
+        *a = add(x, y);
+        *b = mul(sub(x, y), *w);
+    }
+}
+
+// Every butterfly at level m touches one block of 2^m elements, and blocks of
+// one level are independent, so any order that finishes level m-1 within a
+// block before level m on that block computes the recursive result.
+fn fwd(io: &mut [u32], level: usize, expand_bits: usize) {
+    if level == expand_bits || level == 0 {
+        return;
+    }
+    if level <= ITERATIVE_LEVELS {
+        for m in (expand_bits + 1)..=level {
+            let tw = twiddles(true, m);
+            for block in io.chunks_exact_mut(1 << m) {
+                fwd_combine(block, tw);
+            }
+        }
+        return;
+    }
+    let half = 1 << (level - 1);
+    let (lo, hi) = io.split_at_mut(half);
+    fwd(lo, level - 1, expand_bits);
+    fwd(hi, level - 1, expand_bits);
+    fwd_combine(io, twiddles(true, level));
+}
+
+fn rev(io: &mut [u32], level: usize) {
+    if level == 0 {
+        return;
+    }
+    if level <= ITERATIVE_LEVELS {
+        for m in (1..=level).rev() {
+            let tw = twiddles(false, m);
+            for block in io.chunks_exact_mut(1 << m) {
+                rev_combine(block, tw);
+            }
+        }
+        return;
+    }
+    rev_combine(io, twiddles(false, level));
+    let half = 1 << (level - 1);
+    let (lo, hi) = io.split_at_mut(half);
+    rev(lo, level - 1);
+    rev(hi, level - 1);
+}
+
+fn words(io: &mut [BabyBearElem]) -> &mut [u32] {
+    // SAFETY: BabyBearElem is a repr(transparent) u32 Montgomery word, and
+    // the kernels only store canonical words back into it.
+    unsafe { &mut *(io as *mut [BabyBearElem] as *mut [u32]) }
+}
+
+fn level_of(len: usize) -> usize {
+    assert!(len.is_power_of_two());
+    let level = len.trailing_zeros() as usize;
+    assert!(level <= MAX_LEVEL, "NTT size exceeds the tabulated roots");
+    level
+}
+
+/// Same result as `evaluate_ntt::<BabyBearElem, BabyBearElem>`.
+pub(crate) fn evaluate(io: &mut [BabyBearElem], expand_bits: usize) {
+    let level = level_of(io.len());
+    assert!(expand_bits <= level);
+    fwd(words(io), level, expand_bits);
+}
+
+/// Same result as `interpolate_ntt::<BabyBearElem, BabyBearElem>`.
+pub(crate) fn interpolate(io: &mut [BabyBearElem]) {
+    let level = level_of(io.len());
+    let io = words(io);
+    rev(io, level);
+    let norm = BabyBearElem::from_u64(io.len() as u64).inv().as_u32_montgomery();
+    for x in io.iter_mut() {
+        *x = mul(*x, norm);
+    }
+}
+
+/// `3^bitrev(pos)` for every `pos < 2^bits`, in Montgomery form.
+pub(crate) fn shift_table(bits: usize) -> Vec<u32> {
+    assert!((1..=MAX_LEVEL).contains(&bits));
+    let size = 1usize << bits;
+    let three = BabyBearElem::from_u64(3);
+    let mut pow3 = Vec::with_capacity(size);
+    let mut cur = BabyBearElem::ONE;
+    for _ in 0..size {
+        pow3.push(cur.as_u32_montgomery());
+        cur *= three;
+    }
+    (0..size)
+        .map(|pos| pow3[(bit_rev_32(pos as u32) >> (32 - bits)) as usize])
+        .collect()
+}
+
+/// Same result as the scalar `zk_shift` on one polynomial of `table.len()`.
+pub(crate) fn shift_row(row: &mut [BabyBearElem], table: &[u32]) {
+    assert_eq!(row.len(), table.len());
+    for (x, w) in words(row).iter_mut().zip(table) {
+        *x = mul(*x, *w);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use rand::{Rng, SeedableRng};
+
+    use super::*;
+    use crate::core::ntt::{evaluate_ntt, interpolate_ntt};
+
+    fn sample(rng: &mut rand::rngs::StdRng, len: usize) -> Vec<BabyBearElem> {
+        let edge = [0, 1, 2, P - 2, P - 1];
+        (0..len)
+            .map(|i| {
+                let word = if i % 7 == 0 {
+                    edge[(i / 7) % edge.len()]
+                } else {
+                    rng.random_range(0..P)
+                };
+                BabyBearElem::new_raw(word)
+            })
+            .collect()
+    }
+
+    fn montgomery(v: &[BabyBearElem]) -> Vec<u32> {
+        v.iter().map(BabyBearElem::as_u32_montgomery).collect()
+    }
+
+    #[test]
+    fn word_ops_match_field() {
+        let _lock = crate::core::hash::GSR_OPS_TEST_LOCK
+            .lock()
+            .unwrap_or_else(|e| e.into_inner());
+        let mut rng = rand::rngs::StdRng::seed_from_u64(1);
+        let edge = [0, 1, 2, P / 2, P - 2, P - 1];
+        for i in 0..200_000usize {
+            let a = if i < 36 { edge[i % 6] } else { rng.random_range(0..P) };
+            let b = if i < 36 { edge[i / 6] } else { rng.random_range(0..P) };
+            let (x, y) = (BabyBearElem::new_raw(a), BabyBearElem::new_raw(b));
+            assert_eq!(add(a, b), (x + y).as_u32_montgomery());
+            assert_eq!(sub(a, b), (x - y).as_u32_montgomery());
+            assert_eq!(mul(a, b), (x * y).as_u32_montgomery());
+        }
+    }
+
+    #[test]
+    fn ntt_matches_generic() {
+        let _lock = crate::core::hash::GSR_OPS_TEST_LOCK
+            .lock()
+            .unwrap_or_else(|e| e.into_inner());
+        let mut rng = rand::rngs::StdRng::seed_from_u64(2);
+        for level in 0..=16 {
+            let input = sample(&mut rng, 1 << level);
+            for expand_bits in 0..=level.min(4) {
+                let mut want = input.clone();
+                evaluate_ntt::<BabyBearElem, BabyBearElem>(&mut want, expand_bits);
+                let mut got = input.clone();
+                evaluate(&mut got, expand_bits);
+                assert_eq!(montgomery(&got), montgomery(&want), "fwd {level} {expand_bits}");
+            }
+            let mut want = input.clone();
+            interpolate_ntt::<BabyBearElem, BabyBearElem>(&mut want);
+            let mut got = input.clone();
+            interpolate(&mut got);
+            assert_eq!(montgomery(&got), montgomery(&want), "rev {level}");
+        }
+    }
+
+    #[test]
+    fn large_ntt_matches_generic() {
+        let _lock = crate::core::hash::GSR_OPS_TEST_LOCK
+            .lock()
+            .unwrap_or_else(|e| e.into_inner());
+        let mut rng = rand::rngs::StdRng::seed_from_u64(3);
+        for (level, expand_bits) in [(18, 2), (20, 2)] {
+            let input = sample(&mut rng, 1 << level);
+            let mut want = input.clone();
+            evaluate_ntt::<BabyBearElem, BabyBearElem>(&mut want, expand_bits);
+            let mut got = input.clone();
+            evaluate(&mut got, expand_bits);
+            assert_eq!(montgomery(&got), montgomery(&want));
+            interpolate_ntt::<BabyBearElem, BabyBearElem>(&mut want);
+            interpolate(&mut got);
+            assert_eq!(montgomery(&got), montgomery(&want));
+        }
+    }
+
+    #[test]
+    fn shift_matches_scalar() {
+        let _lock = crate::core::hash::GSR_OPS_TEST_LOCK
+            .lock()
+            .unwrap_or_else(|e| e.into_inner());
+        let mut rng = rand::rngs::StdRng::seed_from_u64(4);
+        for bits in [1, 2, 5, 10, 14] {
+            let table = shift_table(bits);
+            let mut row = sample(&mut rng, 1 << bits);
+            let mut want = row.clone();
+            for (pos, x) in want.iter_mut().enumerate() {
+                let rev = bit_rev_32(pos as u32) >> (32 - bits);
+                *x *= BabyBearElem::from_u64(3).pow(rev as usize);
+            }
+            shift_row(&mut row, &table);
+            assert_eq!(montgomery(&row), montgomery(&want));
+        }
+    }
+}
