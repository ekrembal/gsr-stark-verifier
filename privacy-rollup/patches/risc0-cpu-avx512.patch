@@ -0,0 +1,49 @@
+// Experimental prover-only multi-lane arithmetic. No circuit or verifier change.
+#pragma once
+#include "fp.h"
+#include <cstddef>
+#include <cstdint>
+#ifndef GSR_POLY_LANES
+#define GSR_POLY_LANES 8
+#endif
+static_assert(GSR_POLY_LANES == 8 || GSR_POLY_LANES == 16, "GSR_POLY_LANES must be 8 or 16");
+namespace gsr_recursion_batch {
+constexpr size_t LANES = GSR_POLY_LANES;
+using ScalarFp = risc0::Fp;
+using U32 = uint32_t __attribute__((vector_size(4 * GSR_POLY_LANES)));
+using U64 = uint64_t __attribute__((vector_size(8 * GSR_POLY_LANES)));
+class Fp {
+  U32 v;
+  explicit Fp(U32 raw):v(raw){}
+  static U32 splat(uint32_t x) { return U32{} + x; }
+public:
+  static constexpr uint32_t P=ScalarFp::P;
+  Fp():v{}{}
+  Fp(uint32_t x):v(splat(ScalarFp(x).asRaw())){}
+  static Fp broadcast(ScalarFp x) { return Fp(splat(x.asRaw())); }
+  template<class Index> static Fp load(const ScalarFp* ptr, Index index) {
+    U32 raw;
+    for (size_t lane = 0; lane < LANES; ++lane) raw[lane] = ptr[index(lane)].asRaw();
+    return Fp(raw);
+  }
+  static Fp invalid() {return Fp(splat(ScalarFp::INVALID));}
+  uint32_t raw(size_t lane) const {return v[lane];}
+  Fp operator+(Fp rhs) const {U32 s=v+rhs.v; return Fp(s>=P?s-P:s);}
+  Fp operator-(Fp rhs) const {U32 s=v-rhs.v; return Fp(s>P?s+P:s);}
+  Fp operator-() const {return Fp()-*this;}
+  Fp operator*(Fp rhs) const {
+    U64 product=__builtin_convertvector(v,U64)*__builtin_convertvector(rhs.v,U64);
+    U32 red=uint32_t(0x88000001)*(-__builtin_convertvector(product,U32));
+    U64 total=product+__builtin_convertvector(red,U64)*uint64_t(P);
+    U32 reduced=__builtin_convertvector(total>>32,U32);
+    return Fp(reduced>=P?reduced-P:reduced);
+  }
+  Fp operator+=(Fp x){*this=*this+x;return *this;}
+  Fp operator-=(Fp x){*this=*this-x;return *this;}
+  Fp operator*=(Fp x){*this=*this*x;return *this;}
+  bool operator==(Fp x) const {for(size_t i=0;i<LANES;++i)if(v[i]!=x.v[i])return false;return true;}
+  bool operator!=(Fp x) const {return !(*this==x);}
+};
+inline Fp pow(Fp x,size_t n){Fp r(1);while(n){if(n%2)r*=x;n/=2;x*=x;}return r;}
+inline Fp inv(Fp x){return pow(x,Fp::P-2);}
+}
