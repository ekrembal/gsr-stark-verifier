+//! Optional host-only eight-lane evaluation of the unchanged Poseidon2 hash.
+//! Arithmetic accepts canonical Montgomery words only. Unreduced row inputs and
+//! enabled scalar operation instrumentation use the original implementation.
+//! No unsafe code, architecture intrinsics, new hash suite, or new parameters.
+use super::*;
+use core::ops::{Add, Mul};
+use risc0_core::field::{baby_bear::P, gsr_ops};
+
+const LANES: usize = 8;
+
+#[derive(Clone, Copy)]
+struct Packed([u32; LANES]);
+
+impl Packed {
+    const ZERO: Self = Self([0; LANES]);
+    fn splat(value: BabyBearElem) -> Self {
+        Self([value.as_u32_montgomery(); LANES])
+    }
+}
+
+impl Add for Packed {
+    type Output = Self;
+    #[inline(always)]
+    fn add(self, rhs: Self) -> Self {
+        Self(core::array::from_fn(|i| {
+            // Both operands are below P < 2^31; addition cannot overflow.
+            let sum = self.0[i] + rhs.0[i];
+            if sum >= P {
+                sum - P
+            } else {
+                sum
+            }
+        }))
+    }
+}
+
+impl Mul for Packed {
+    type Output = Self;
+    #[inline(always)]
+    fn mul(self, rhs: Self) -> Self {
+        Self(core::array::from_fn(|i| {
+            // Same Montgomery reduction as baby_bear::mul. For a,b < P,
+            // a*b + red*P <= (P-1)^2 + (2^32-1)*P < 2^64.
+            let product = u64::from(self.0[i]) * u64::from(rhs.0[i]);
+            let red = 0x88000001u32.wrapping_mul(0u32.wrapping_sub(product as u32));
+            let reduced = ((product + u64::from(red) * u64::from(P)) >> 32) as u32;
+            if reduced >= P {
+                reduced - P
+            } else {
+                reduced
+            }
+        }))
+    }
+}
+
+fn sbox(x: Packed) -> Packed {
+    let x2 = x * x;
+    let x4 = x2 * x2;
+    let x6 = x4 * x2;
+    x6 * x
+}
+
+fn external(cells: &mut [Packed; CELLS]) {
+    let mut sums = [Packed::ZERO; 4];
+    for chunk in cells.chunks_exact_mut(4) {
+        let t0 = chunk[0] + chunk[1];
+        let t1 = chunk[2] + chunk[3];
+        let t2 = (chunk[1] + chunk[1]) + t1;
+        let t3 = (chunk[3] + chunk[3]) + t0;
+        let t4 = ((t1 + t1) + (t1 + t1)) + t3;
+        let t5 = ((t0 + t0) + (t0 + t0)) + t2;
+        let out = [t3 + t5, t5, t2 + t4, t4];
+        for i in 0..4 {
+            chunk[i] = out[i];
+            sums[i] = sums[i] + out[i];
+        }
+    }
+    for i in 0..CELLS {
+        cells[i] = cells[i] + sums[i % 4];
+    }
+}
+
+fn internal(cells: &mut [Packed; CELLS]) {
+    let sum = cells.iter().fold(Packed::ZERO, |sum, x| sum + *x);
+    for i in 0..CELLS {
+        cells[i] = sum + Packed::splat(M_INT_DIAG_HZN[i]) * cells[i];
+    }
+}
+
+fn mix(cells: &mut [Packed; CELLS], lanes: usize) {
+    super::super::gsr_counters::bump(&super::super::gsr_counters::P2_PERMUTE, lanes as u64);
+    external(cells);
+    for round in 0..(2 * ROUNDS_HALF_FULL + ROUNDS_PARTIAL) {
+        if round < ROUNDS_HALF_FULL || round >= ROUNDS_HALF_FULL + ROUNDS_PARTIAL {
+            for i in 0..CELLS {
+                cells[i] = sbox(cells[i] + Packed::splat(ROUND_CONSTANTS[round * CELLS + i]));
+            }
+            external(cells);
+        } else {
+            cells[0] = sbox(cells[0] + Packed::splat(ROUND_CONSTANTS[round * CELLS]));
+            internal(cells);
+        }
+    }
+}
+
+fn finish(output: &mut [Digest], cells: &[Packed; CELLS]) {
+    for (lane, digest) in output.iter_mut().enumerate() {
+        *digest = Digest::from(core::array::from_fn::<_, DIGEST_WORDS, _>(|i| {
+            cells[i].0[lane]
+        }));
+    }
+}
+
+pub(super) fn hash_rows(output: &mut [Digest], matrix: &[BabyBearElem], rows: usize, start: usize) {
+    assert!(rows > 0 && matrix.len() % rows == 0);
+    assert!(start <= rows && output.len() <= rows - start);
+    assert!(output.len() <= LANES);
+    let columns = matrix.len() / rows;
+    let canonical = matrix.chunks_exact(rows).all(|col| {
+        col[start..start + output.len()]
+            .iter()
+            .all(Elem::is_reduced)
+    });
+    if gsr_ops::is_enabled() || !canonical {
+        for (lane, digest) in output.iter_mut().enumerate() {
+            *digest = *to_digest(unpadded_hash(
+                matrix.chunks_exact(rows).map(|col| &col[start + lane]),
+            ));
+        }
+        return;
+    }
+    if output.is_empty() {
+        return;
+    }
+    let mut cells = [Packed::ZERO; CELLS];
+    for block in 0..columns.div_ceil(CELLS_RATE).max(1) {
+        for i in 0..CELLS_RATE {
+            cells[i] = Packed::ZERO;
+            let column = block * CELLS_RATE + i;
+            if column < columns {
+                for lane in 0..output.len() {
+                    cells[i].0[lane] = matrix[column * rows + start + lane].as_u32_montgomery();
+                }
+            }
+        }
+        mix(&mut cells, output.len());
+    }
+    finish(output, &cells);
+}
+
+pub(super) fn hash_pairs(output: &mut [Digest], input: &[Digest]) {
+    assert_eq!(input.len(), 2 * output.len());
+    assert!(output.len() <= LANES);
+    // Retain the original hash_pair requirement, including INVALID and >=P.
+    assert!(input
+        .iter()
+        .flat_map(Digest::as_words)
+        .all(|word| *word < P));
+    if gsr_ops::is_enabled() {
+        let scalar = Poseidon2HashFn;
+        for (digest, pair) in output.iter_mut().zip(input.chunks_exact(2)) {
+            *digest = *scalar.hash_pair(&pair[0], &pair[1]);
+        }
+        return;
+    }
+    if output.is_empty() {
+        return;
+    }
+    let mut cells = [Packed::ZERO; CELLS];
+    for (lane, pair) in input.chunks_exact(2).enumerate() {
+        for (i, word) in pair[0]
+            .as_words()
+            .iter()
+            .chain(pair[1].as_words())
+            .enumerate()
+        {
+            cells[i].0[lane] = *word;
+        }
+    }
+    mix(&mut cells, output.len());
+    finish(output, &cells);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn batched_counter_fallback_matches_scalar() {
+        struct Disable;
+        impl Drop for Disable {
+            fn drop(&mut self) {
+                gsr_ops::enable(false);
+            }
+        }
+        gsr_ops::enable(true);
+        let _disable = Disable;
+        let scalar = Poseidon2HashFn;
+        let matrix: Vec<_> = (0..51).map(|i| BabyBearElem::new(i * 1234567)).collect();
+        let before = gsr_ops::snapshot();
+        let mut out = [Digest::ZERO; 3];
+        hash_rows(&mut out, &matrix, 3, 0);
+        let middle = gsr_ops::snapshot();
+        for i in 0..3 {
+            let row: Vec<_> = matrix.chunks_exact(3).map(|col| col[i]).collect();
+            assert_eq!(out[i], *scalar.hash_elem_slice(&row));
+        }
+        let after = gsr_ops::snapshot();
+        for i in 0..before.len() {
+            assert_eq!(middle[i] - before[i], after[i] - middle[i]);
+        }
+        let pairs = [out[0], out[1], out[1], out[2]];
+        let before = gsr_ops::snapshot();
+        let mut output = [Digest::ZERO; 2];
+        hash_pairs(&mut output, &pairs);
+        let middle = gsr_ops::snapshot();
+        for i in 0..2 {
+            assert_eq!(
+                output[i],
+                *scalar.hash_pair(&pairs[2 * i], &pairs[2 * i + 1])
+            );
+        }
+        let after = gsr_ops::snapshot();
+        for i in 0..before.len() {
+            assert_eq!(middle[i] - before[i], after[i] - middle[i]);
+        }
+    }
+
+    #[test]
+    fn batched_field_matches_scalar() {
+        let mut state = 0x123456789abcdef0u64;
+        let boundary = [0, 1, 2, P / 2, P - 2, P - 1, 0, P - 1];
+        for round in 0..1024 {
+            let a = if round == 0 {
+                boundary
+            } else {
+                core::array::from_fn(|_| {
+                    state ^= state << 13;
+                    state ^= state >> 7;
+                    state ^= state << 17;
+                    (state % u64::from(P)) as u32
+                })
+            };
+            let b = core::array::from_fn(|i| {
+                if round == 0 {
+                    boundary[7 - i]
+                } else if round % 2 == 0 {
+                    boundary[i]
+                } else {
+                    state ^= state << 13;
+                    state ^= state >> 7;
+                    state ^= state << 17;
+                    (state % u64::from(P)) as u32
+                }
+            });
+            let sum = Packed(a) + Packed(b);
+            let product = Packed(a) * Packed(b);
+            for i in 0..LANES {
+                let aa = BabyBearElem::new_raw(a[i]);
+                let bb = BabyBearElem::new_raw(b[i]);
+                assert_eq!(sum.0[i], (aa + bb).as_u32_montgomery());
+                assert_eq!(product.0[i], (aa * bb).as_u32_montgomery());
+            }
+        }
+    }
+
+    #[test]
+    fn batched_rows_match_scalar_boundaries() {
+        let scalar = Poseidon2HashFn;
+        for rows in [1, 3, 8, 9, 17] {
+            for columns in [0, 1, 7, 15, 16, 17, 31, 32, 33, 128] {
+                let matrix: Vec<_> = (0..rows * columns)
+                    .map(|i| {
+                        BabyBearElem::new_raw(
+                            [
+                                0,
+                                1,
+                                P - 1,
+                                P / 2,
+                                ((i as u64 * 987654321) % u64::from(P)) as u32,
+                            ][i % 5],
+                        )
+                    })
+                    .collect();
+                for start in 0..=rows {
+                    let count = (rows - start).min(LANES);
+                    let mut out = vec![Digest::ZERO; count];
+                    hash_rows(&mut out, &matrix, rows, start);
+                    for lane in 0..count {
+                        let column: Vec<_> = matrix
+                            .chunks_exact(rows)
+                            .map(|col| col[start + lane])
+                            .collect();
+                        assert_eq!(out[lane], *scalar.hash_elem_slice(&column));
+                    }
+                }
+            }
+        }
+        // Unreduced row encodings retain the scalar behavior instead of entering
+        // arithmetic whose no-overflow contract requires canonical operands.
+        let matrix = [BabyBearElem::new_raw(P), BabyBearElem::new_raw(P + 1)];
+        let mut out = [Digest::ZERO; 2];
+        hash_rows(&mut out, &matrix, 2, 0);
+        for i in 0..2 {
+            assert_eq!(out[i], *scalar.hash_elem_slice(&matrix[i..i + 1]));
+        }
+    }
+
+    #[test]
+    fn batched_pairs_match_scalar_and_reject_unreduced() {
+        let scalar = Poseidon2HashFn;
+        for count in 0..=LANES {
+            let input: Vec<_> = (0..2 * count)
+                .map(|i| {
+                    Digest::from(core::array::from_fn::<_, DIGEST_WORDS, _>(|j| {
+                        [0, P - 1, 1, ((i * 10000 + j * 13) as u32) % P][(i + j) % 4]
+                    }))
+                })
+                .collect();
+            let mut out = vec![Digest::ZERO; count];
+            hash_pairs(&mut out, &input);
+            for i in 0..count {
+                assert_eq!(out[i], *scalar.hash_pair(&input[2 * i], &input[2 * i + 1]));
+            }
+        }
+        for bad in [P, P + 1, u32::MAX] {
+            let input = [Digest::from([bad; DIGEST_WORDS]), Digest::ZERO];
+            assert!(std::panic::catch_unwind(|| hash_pairs(&mut [Digest::ZERO], &input)).is_err());
+            assert!(std::panic::catch_unwind(|| scalar.hash_pair(&input[0], &input[1])).is_err());
+        }
+    }
+}
