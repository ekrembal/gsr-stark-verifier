+// (3 * g^cycle)^(2^po2) has period INV_RATE because g has order
+// 2^po2 * INV_RATE. Evaluate the original expression at each residue;
+// preserve the field's existing inverse semantics exactly.
+fn periodic_quotients(po2: usize) -> [Val; INV_RATE] {
+    let root = Val::ROU_FWD[po2 + log2_ceil(INV_RATE)];
+    core::array::from_fn(|residue| {
+        let x = root.pow(residue);
+        let y = (Val::new(3) * x).pow(1 << po2);
+        (y - Val::new(1)).inv()
+    })
+}
