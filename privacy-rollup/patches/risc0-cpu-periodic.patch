+#[cfg(test)]
+mod periodic_tests {
+    use super::*;
+
+    #[test]
+    fn periodic_divisors_match_reference() {
+        for po2 in [5, 10, 15, 18, 20] {
+            let weights = periodic_quotients(po2);
+            let domain = (1usize << po2) * INV_RATE;
+            for cycle in (0..512).chain([domain - 1, domain, domain + 1, u32::MAX as usize]) {
+                let root = Val::ROU_FWD[po2 + log2_ceil(INV_RATE)];
+                let expected = ((Val::new(3) * root.pow(cycle)).pow(1 << po2) - Val::new(1)).inv();
+                assert_eq!(weights[cycle % INV_RATE], expected);
+                assert_ne!(expected, Val::ZERO);
+            }
+        }
+    }
+}
