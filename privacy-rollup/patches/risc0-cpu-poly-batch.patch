+++ b/risc0/circuit/rv32im-sys/kernels/cxx_batch/ffi.cpp
@@ -0,0 +1,32 @@
+// Optional host prover evaluator; the scalar circuit and verifier are unchanged.
+#include "packed_fpext.h"
+#include <cstring>
+#include <exception>
+#include <type_traits>
+
+extern "C" bool risc0_circuit_rv32im_cpu_poly_fp_batch_available() { return true; }
+
+extern "C" const char* risc0_circuit_rv32im_cpu_poly_fp_batch(
+    size_t cycle, size_t steps, const risc0::FpExt* mixes,
+    const risc0::Fp* const* args, risc0::FpExt* result) {
+  static_assert(sizeof(risc0::Fp) == sizeof(uint32_t));
+  static_assert(std::is_trivially_copyable_v<risc0::Fp>);
+  static_assert(std::is_standard_layout_v<risc0::Fp>);
+  static_assert(sizeof(risc0::FpExt) == 4 * sizeof(risc0::Fp));
+  try {
+    auto packed = gsr_poly_batch::poly_fp(cycle, steps, {mixes}, args);
+    for (size_t lane = 0; lane < 8; ++lane) {
+      for (size_t component = 0; component < 4; ++component) {
+        // Copy the exact Montgomery word; invoking Fp(uint32_t) would encode
+        // it again. memcpy is valid for this trivially copyable scalar type.
+        uint32_t word = packed.elems[component].raw(lane);
+        std::memcpy(&result[lane].elems[component], &word, sizeof word);
+      }
+    }
+  } catch (const std::exception& error) {
+    return strdup(error.what());
+  } catch (...) {
+    return strdup("batched polynomial evaluation failed");
+  }
+  return nullptr;
+}
