 //! CPU implementation of the HAL.
 
-use std::{fmt::Debug, ops::Range, sync::Arc};
+use std::{
+    fmt::Debug,
+    ops::Range,
+    sync::{Arc, OnceLock},
+    time::Instant,
+};
+
+// Optional host-only wall-time instrumentation. Each record covers one complete
+// HAL call, including its Rayon workers. No input or proof contents are logged.
+struct CpuOpTimer {
+    name: &'static str,
+    start: Option<Instant>,
+}
+
+impl CpuOpTimer {
+    fn new(name: &'static str) -> Self {
+        static ENABLED: OnceLock<bool> = OnceLock::new();
+        let enabled = *ENABLED.get_or_init(|| std::env::var("GSR_PROFILE_CPU").as_deref() == Ok("1"));
+        Self {
+            name,
+            start: enabled.then(Instant::now),
+        }
+    }
+}
+
+impl Drop for CpuOpTimer {
+    fn drop(&mut self) {
+        if let Some(start) = self.start {
+            eprintln!("gsr_cpu_op {} {}", self.name, start.elapsed().as_nanos());
+        }
+    }
+}
 
