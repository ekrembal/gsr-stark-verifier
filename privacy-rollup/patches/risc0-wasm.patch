+// Single-threaded, exception-free build support for wasm32-wasip1.
+#pragma once
+
+#if defined(__wasm__)
+
+#define NVTX_DISABLE
+
+#include <algorithm>
+#include <array>
+#include <cassert>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <exception>
+#include <functional>
+#include <iomanip>
+#include <iostream>
+#include <iterator>
+#include <map>
+#include <memory>
+#include <numeric>
+#include <queue>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <tuple>
+#include <type_traits>
+#include <utility>
+#include <vector>
+
+#define POOLSTL_HPP
+
+namespace poolstl {
+
+template <typename T> class iota_iter {
+public:
+  using value_type = T;
+  using difference_type = std::ptrdiff_t;
+  using pointer = T*;
+  using reference = T;
+  using iterator_category = std::random_access_iterator_tag;
+
+  iota_iter() : value{} {}
+  explicit iota_iter(T rhs) : value(rhs) {}
+  reference operator*() const { return value; }
+  reference operator[](difference_type rhs) const { return value + rhs; }
+  bool operator==(const iota_iter& rhs) const { return value == rhs.value; }
+  bool operator!=(const iota_iter& rhs) const { return value != rhs.value; }
+  bool operator<(const iota_iter& rhs) const { return value < rhs.value; }
+  iota_iter& operator+=(difference_type rhs) {
+    value += rhs;
+    return *this;
+  }
+  iota_iter& operator++() {
+    ++value;
+    return *this;
+  }
+  iota_iter operator++(int) {
+    iota_iter ret(value);
+    ++value;
+    return ret;
+  }
+  difference_type operator-(const iota_iter& rhs) const { return value - rhs.value; }
+  iota_iter operator+(difference_type rhs) const { return iota_iter(value + rhs); }
+
+private:
+  T value;
+};
+
+struct sequential_par {};
+inline constexpr sequential_par par{};
+
+} // namespace poolstl
+
+namespace std {
+
+template <class It, class F> void for_each(poolstl::sequential_par, It first, It last, F f) {
+  std::for_each(first, last, f);
+}
+
+template <class It> void sort(poolstl::sequential_par, It first, It last) {
+  std::sort(first, last);
+}
+
+template <class It, class Out, class T>
+Out exclusive_scan(poolstl::sequential_par, It first, It last, Out out, T init) {
+  return std::exclusive_scan(first, last, out, init);
+}
+
+} // namespace std
+
+namespace risc0_wasm {
+
+struct Thrower {
+  [[noreturn]] void operator=(const std::exception& err) const {
+    fprintf(stderr, "fatal: %s\n", err.what());
+    abort();
+  }
+};
+
+inline const std::exception& never_caught() {
+  static const std::exception err;
+  return err;
+}
+
+} // namespace risc0_wasm
+
+#define try if (true)
+#define catch(decl) for (decl = ::risc0_wasm::never_caught(); false;)
+#define throw ::risc0_wasm::Thrower{} =
+
+#endif
