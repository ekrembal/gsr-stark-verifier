+    /// Like [PolyGroup::new], but every Merkle leaf also contains [ZK_SALT_SIZE] fresh
+    /// uniformly random field elements, so that the commitment hides the leaf values.
+    pub fn new_salted(
+        hal: &H,
+        coeffs: H::Buffer<H::Elem>,
+        count: usize,
+        size: usize,
+        name: &'static str,
+    ) -> Self {
+        scope_with!("poly_group_salted({})", name);
+        assert_eq!(coeffs.size(), count * size);
+        let domain = size * INV_RATE;
+        let evaluated = hal.alloc_elem("evaluated", count * domain);
+        hal.batch_expand_into_evaluate_ntt(&evaluated, &coeffs, count, log2_ceil(INV_RATE));
+        hal.batch_bit_reverse(&coeffs, count);
+        let mut rng = rand::rng();
+        let mut salted = Vec::with_capacity((count + ZK_SALT_SIZE) * domain);
+        evaluated.view(|view| salted.extend_from_slice(view));
+        salted.extend((0..ZK_SALT_SIZE * domain).map(|_| H::Elem::random(&mut rng)));
+        let salted = hal.copy_from_elem("salted", &salted);
+        let merkle = MerkleTreeProver::new(hal, &salted, domain, count + ZK_SALT_SIZE, QUERIES);
+        PolyGroup {
+            coeffs,
+            count,
+            evaluated,
+            merkle,
+        }
+    }
 }
