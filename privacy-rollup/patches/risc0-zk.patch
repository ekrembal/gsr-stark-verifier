+/// Re-prove a succinct receipt with the identity program under the zero-knowledge prover.
+///
+/// The returned seal reveals only the claim and the control root: the inner receipt (and
+/// everything below it) is part of the hidden witness. Verify it with
+/// [SuccinctReceipt::verify_integrity_zk_with_context], or consume it with [resolve_zk].
+pub fn identity_zk(inner: &SuccinctReceipt<ReceiptClaim>) -> Result<SuccinctReceipt<ReceiptClaim>> {
+    let mut prover = Prover::new_identity(inner, ProverOpts::succinct())?;
+    let receipt = prover.prover.run_zk()?;
+    let claim =
+        MaybePruned::Value(ReceiptClaim::decode(&mut receipt.out_stream())?).merge(&inner.claim)?;
+    make_succinct_receipt(prover, receipt, claim)
+}
+
+/// Like [resolve], but the assumption receipt carries a zero-knowledge seal (see
+/// [identity_zk]); it is verified by the `resolve_zk` recursion program.
+pub fn resolve_zk<Claim>(
+    conditional: &SuccinctReceipt<ReceiptClaim>,
+    assumption: &SuccinctReceipt<Claim>,
+) -> Result<SuccinctReceipt<ReceiptClaim>>
+where
+    Claim: risc0_binfmt::Digestible + Debug,
+{
+    let mut prover = Prover::new_resolve_zk(conditional, assumption, ProverOpts::succinct())?;
+    let receipt = prover.prover.run()?;
+    let claim_decoded = ReceiptClaim::decode(&mut receipt.out_stream())?;
+    let claim = conditional
+        .claim
+        .as_value()
+        .context("conditional receipt claim is pruned")?
+        .resolve(&assumption.claim)
+        .context("failed to compute resolved claim")?
+        .merge(&claim_decoded)
+        .context("failed to merge resolved and decoded claims")?;
+    make_succinct_receipt(prover, receipt, claim)
+}
