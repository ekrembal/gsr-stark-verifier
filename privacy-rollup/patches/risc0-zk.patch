+#[test_log::test]
+fn zk_po2_16_accept_and_reject() {
+    let (control_root, ctx) = test_po2_16_ctx();
+    let digest = digest!("00000000000000de00000000000000ad00000000000000be00000000000000ef");
+    let receipt = super::test_zkr_mode(&control_root, &digest, 16, true).unwrap();
+    receipt.verify_integrity_zk_with_context(&ctx).unwrap();
+
+    // The zero-knowledge seal is not a valid seal of the plain protocol, and vice versa.
+    assert!(receipt.verify_integrity_with_context(&ctx).is_err());
+    let plain = super::test_zkr_mode(&control_root, &digest, 16, false).unwrap();
+    plain.verify_integrity_with_context(&ctx).unwrap();
+    assert!(plain.verify_integrity_zk_with_context(&ctx).is_err());
+
+    // Two proofs of the same statement differ (fresh randomness) and both verify.
+    let again = super::test_zkr_mode(&control_root, &digest, 16, true).unwrap();
+    again.verify_integrity_zk_with_context(&ctx).unwrap();
+    assert_ne!(receipt.seal, again.seal);
+
+    // Flipping any part of the seal is rejected: globals, roots, openings, salts, FRI.
+    let len = receipt.seal.len();
+    for pos in [0, 20, 40, 100, len / 8, len / 4, len / 2, 3 * len / 4, len - 10, len - 1] {
+        let mut bad = receipt.clone();
+        bad.seal[pos] ^= 1;
+        assert!(
+            bad.verify_integrity_zk_with_context(&ctx).is_err(),
+            "tampered word {pos} of {len} accepted"
+        );
+    }
+    let mut short = receipt.clone();
+    short.seal.pop();
+    assert!(short.verify_integrity_zk_with_context(&ctx).is_err());
+    let mut long = receipt.clone();
+    long.seal.push(0);
+    assert!(long.verify_integrity_zk_with_context(&ctx).is_err());
+
+    // Wrong statement: a receipt for a different claim digest does not verify as this one.
+    let mut wrong_claim = receipt.clone();
+    wrong_claim.claim = MaybePruned::Pruned(Digest::ZERO);
+    assert!(wrong_claim.verify_integrity_zk_with_context(&ctx).is_err());
