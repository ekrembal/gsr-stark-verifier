+/// GSR cost research: measure seal bytes and verifier hash work for a real multi-segment
+/// succinct receipt, in both the stock poseidon2 configuration and the sha-256 configuration.
+#[test_log::test]
+fn gsr_measure() {
+    use risc0_zkp::core::hash::gsr_counters;
+
+    fn report(label: &str, before: [u64; 4], after: [u64; 4]) {
+        let d = |i: usize| after[i] - before[i];
+        println!(
+            "{label}: sha_pair {}, sha_slice {} over {} bytes, poseidon2 {}",
+            d(0),
+            d(1),
+            d(2),
+            d(3)
+        );
+    }
+
+    let (journal, segments) = BUSY_LOOP_SEGMENTS.clone();
+    println!("segments                 : {}", segments.len());
+    println!(
+        "segment seal bytes       : {}",
+        segments.iter().map(|s| s.seal.len() * 4).sum::<usize>()
+    );
+
+    let ctx = VerifierContext::default();
+    tracing::info!("Proving lift");
+    let mut compressed = lift(&segments[0]).unwrap();
+    for receipt in &segments[1..] {
+        tracing::info!("Proving lift");
+        let rec_receipt = lift(receipt).unwrap();
+        tracing::info!("Proving join");
+        compressed = join(&compressed, &rec_receipt).unwrap();
+    }
+
+    println!(
+        "poseidon2 seal bytes     : {}",
+        compressed.seal.len() * 4
+    );
+    println!(
+        "poseidon2 receipt bytes  : {}",
+        bincode::serialize(&Receipt::new(
+            InnerReceipt::Succinct(compressed.clone()),
+            journal.bytes.clone()
+        ))
+        .unwrap()
+        .len()
+    );
+
+    let before = gsr_counters::snapshot();
+    compressed.verify_integrity_with_context(&ctx).unwrap();
+    report("poseidon2 verify", before, gsr_counters::snapshot());
+
+    // Re-prove the final layer with the sha-256 hash suite, the stock analogue of identity_p254.
+    let (_, control_id_sha256) = zkr::identity("sha-256").unwrap();
+    let opts = ProverOpts::succinct()
+        .with_hashfn("sha-256".to_string())
+        .with_control_ids(vec![control_id_sha256]);
+    let mut prover = Prover::new_identity(&compressed, opts.clone()).unwrap();
+    let sha_recursion_receipt = prover.run().unwrap();
+
+    let hashfn = opts.hash_suite().unwrap().hashfn;
+    let control_tree = MerkleGroup::new(opts.control_ids.clone()).unwrap();
+    let params = SuccinctReceiptVerifierParameters {
+        control_root: control_tree.calc_root(hashfn.as_ref()),
+        inner_control_root: Some(ALLOWED_CONTROL_ROOT),
+        proof_system_info: PROOF_SYSTEM_INFO,
+        circuit_info: CircuitImpl::CIRCUIT_INFO,
+    };
+    let sha_receipt = SuccinctReceipt {
+        seal: sha_recursion_receipt.seal,
+        hashfn: opts.hashfn,
+        control_id: control_id_sha256,
+        control_inclusion_proof: control_tree
+            .get_proof(&control_id_sha256, hashfn.as_ref())
+            .unwrap(),
+        claim: compressed.claim.clone(),
+        verifier_parameters: params.digest(),
+    };
+
+    println!("sha-256 seal bytes       : {}", sha_receipt.seal.len() * 4);
+    println!(
+        "sha-256 receipt bytes    : {}",
+        bincode::serialize(&Receipt::new(
+            InnerReceipt::Succinct(sha_receipt.clone()),
+            journal.bytes.clone()
+        ))
+        .unwrap()
+        .len()
+    );
+
+    let sha_ctx = VerifierContext::empty()
+        .with_suites(VerifierContext::default_hash_suites())
+        .with_succinct_verifier_parameters(params);
+    let before = gsr_counters::snapshot();
+    sha_receipt.verify_integrity_with_context(&sha_ctx).unwrap();
+    report("sha-256 verify", before, gsr_counters::snapshot());
+}
