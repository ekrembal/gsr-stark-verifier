 use super::digest::Digest;
 
+/// Instrumentation for GSR cost research: counts hash work in the verifier.
+pub mod gsr_counters {
+    use core::sync::atomic::{AtomicU64, Ordering};
+
+    /// SHA-256 compression-function calls on digest pairs (Merkle parents, Fiat-Shamir steps).
+    pub static SHA_PAIR: AtomicU64 = AtomicU64::new(0);
+    /// SHA-256 calls over field-element slices (Merkle leaves).
+    pub static SHA_SLICE: AtomicU64 = AtomicU64::new(0);
+    /// Bytes fed to those slice hashes.
+    pub static SHA_SLICE_BYTES: AtomicU64 = AtomicU64::new(0);
+    /// Poseidon2 permutations.
+    pub static P2_PERMUTE: AtomicU64 = AtomicU64::new(0);
+
+    /// Snapshot of every counter.
+    pub fn snapshot() -> [u64; 4] {
+        [
+            SHA_PAIR.load(Ordering::Relaxed),
+            SHA_SLICE.load(Ordering::Relaxed),
+            SHA_SLICE_BYTES.load(Ordering::Relaxed),
+            P2_PERMUTE.load(Ordering::Relaxed),
+        ]
+    }
+
+    pub(crate) fn bump(counter: &AtomicU64, by: u64) {
+        counter.fetch_add(by, Ordering::Relaxed);
+    }
+}
