+
+    let before = gsr_counters::snapshot();
+    let before_ops = gsr_ops::snapshot();
+    gsr_ops::enable(true);
+    compressed.verify_integrity_with_context(&ctx).unwrap();
+    gsr_ops::enable(false);
+    report("poseidon2 verify", before, gsr_counters::snapshot());
+    report_ops("poseidon2 verify", &before_ops, &gsr_ops::snapshot());
