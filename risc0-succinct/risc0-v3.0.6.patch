+/// GSR cost research: measure seal bytes and verifier hash work for a real multi-segment
+/// succinct receipt, in both the stock poseidon2 configuration and the sha-256 configuration.
+#[test_log::test]
+fn gsr_measure() {
+    use risc0_core::field::gsr_ops;
+    use risc0_zkp::core::hash::gsr_counters;
+
+    fn report(label: &str, before: [u64; 4], after: [u64; 4]) {
+        let d = |i: usize| after[i] - before[i];
+        println!(
+            "{label}: sha_pair {}, sha_slice {} over {} bytes, poseidon2 {}",
+            d(0),
+            d(1),
+            d(2),
+            d(3)
+        );
+    }
+
+    fn report_ops(label: &str, before: &[u64], after: &[u64]) {
+        for (p, phase) in gsr_ops::PHASES.iter().enumerate() {
+            for (o, op) in gsr_ops::OPS.iter().enumerate() {
+                let i = p * gsr_ops::OPS.len() + o;
+                println!("{label}: {phase} {op} {}", after[i] - before[i]);
+            }
+        }
+    }
+
+    let (journal, segments) = BUSY_LOOP_SEGMENTS.clone();
+    println!("segments                 : {}", segments.len());
+    println!(
+        "segment seal bytes       : {}",
+        segments.iter().map(|s| s.seal.len() * 4).sum::<usize>()
+    );
+
+    let ctx = VerifierContext::default();
+    tracing::info!("Proving lift");
+    let mut compressed = lift(&segments[0]).unwrap();
+    for receipt in &segments[1..] {
+        tracing::info!("Proving lift");
+        let rec_receipt = lift(receipt).unwrap();
+        tracing::info!("Proving join");
+        compressed = join(&compressed, &rec_receipt).unwrap();
+    }
+
+    println!(
+        "poseidon2 seal bytes     : {}",
+        compressed.seal.len() * 4
+    );
+    println!(
+        "poseidon2 receipt bytes  : {}",
+        bincode::serialize(&Receipt::new(
