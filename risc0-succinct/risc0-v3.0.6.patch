+//! A hash suite built from padded, standards-compliant SHA-256 of [FIPS 180-4].
+//!
+//! The stock [`sha`](super::sha) suite commits with the bare SHA-256 compression function:
+//! `hash_pair` is `compress(SHA256_INIT, a, b)` and slice hashes are unpadded Merkle–Damgård.
+//! Neither is a hash of any preimage under FIPS 180-4, so a verifier that only has a full
+//! SHA-256 (such as Bitcoin Script's `OP_SHA256`) cannot reproduce those digests.
+//!
+//! This suite hashes exactly the same preimage bytes, in the same order, with the padding and
+//! length trailer added, so every digest it produces is `SHA256(preimage)`.
+//!
+//! [FIPS 180-4]: https://nvlpubs.nist.gov/nistpubs/FIPS/NIST.FIPS.180-4.pdf
+
+use alloc::boxed::Box;
+use core::marker::PhantomData;
+
+use rand_core::{impls, RngCore};
+use risc0_core::field::{Elem, Field};
+
+use super::{
+    gsr_counters,
+    sha::{Impl, Sha256},
+    HashSuite, Rng, RngFactory,
+};
+use crate::core::digest::{Digest, DIGEST_BYTES, DIGEST_WORDS};
+
+/// Name under which this suite is registered with [`hash_suite_from_name`](super::hash_suite_from_name).
+pub const SHA256_PADDED: &str = "sha-256-padded";
+
+struct PaddedSha256HashFn;
+
+fn hash_pair_padded(a: &Digest, b: &Digest) -> Box<Digest> {
+    let mut block = [0u8; 2 * DIGEST_BYTES];
+    block[..DIGEST_BYTES].copy_from_slice(a.as_bytes());
+    block[DIGEST_BYTES..].copy_from_slice(b.as_bytes());
+    gsr_counters::bump(&gsr_counters::SHA_PAIR, 1);
+    (*Impl::hash_bytes(&block)).into()
+}
+
+fn hash_slice_padded<T: bytemuck::NoUninit>(slice: &[T]) -> Box<Digest> {
+    let bytes: &[u8] = bytemuck::cast_slice(slice);
+    gsr_counters::bump(&gsr_counters::SHA_SLICE, 1);
+    gsr_counters::bump(&gsr_counters::SHA_SLICE_BYTES, bytes.len() as u64);
+    (*Impl::hash_bytes(bytes)).into()
+}
+
+impl<F: Field> super::HashFn<F> for PaddedSha256HashFn {
+    fn hash_pair(&self, a: &Digest, b: &Digest) -> Box<Digest> {
+        hash_pair_padded(a, b)
+    }
+
+    fn hash_elem_slice(&self, slice: &[F::Elem]) -> Box<Digest> {
+        hash_slice_padded(slice)
+    }
+
+    fn hash_ext_elem_slice(&self, slice: &[F::ExtElem]) -> Box<Digest> {
+        hash_slice_padded(slice)
+    }
+}
+
+/// Fiat-Shamir CRNG driven by padded SHA-256.
+///
+/// Mirrors the stock `ShaRng` with `hash_pair` replaced by `SHA256(pool0 || pool1)`,
+/// and the two seeds are already standard hashes in the stock RNG.
+#[derive(Clone, Debug)]
+pub struct PaddedShaRng {
+    pool0: Box<Digest>,
+    pool1: Box<Digest>,
+    pool_used: usize,
+}
+
+impl Default for PaddedShaRng {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl PaddedShaRng {
+    /// Create a new [PaddedShaRng].
+    pub fn new() -> Self {
+        Self {
+            pool0: (*Impl::hash_bytes(b"Hello")).into(),
+            pool1: (*Impl::hash_bytes(b"World")).into(),
+            pool_used: 0,
+        }
+    }
+
+    /// Mix the pool with a specified [Digest].
+    pub fn inner_mix(&mut self, val: &Digest) {
+        for i in 0..DIGEST_WORDS {
+            self.pool0.as_mut_words()[i] = self.pool0.as_words()[i] ^ val.as_words()[i];
+        }
+        self.step();
+    }
+
+    fn step(&mut self) {
+        self.pool0 = hash_pair_padded(&self.pool0, &self.pool1);
+        self.pool1 = hash_pair_padded(&self.pool0, &self.pool1);
+        self.pool_used = 0;
+    }
+}
+
+impl RngCore for PaddedShaRng {
+    fn next_u32(&mut self) -> u32 {
+        if self.pool_used == DIGEST_WORDS {
+            self.step();
+        }
+        let out = self.pool0.as_words()[self.pool_used];
+        self.pool_used += 1;
+        out
+    }
+
+    fn next_u64(&mut self) -> u64 {
+        ((self.next_u32() as u64) << 32) | (self.next_u32() as u64)
+    }
+
+    fn fill_bytes(&mut self, dest: &mut [u8]) {
+        impls::fill_bytes_via_next(self, dest);
+    }
+}
+
+impl<F: Field> Rng<F> for PaddedShaRng {
+    fn mix(&mut self, val: &Digest) {
+        self.inner_mix(val);
+    }
+
+    fn random_bits(&mut self, bits: usize) -> u32 {
+        ((1 << bits) - 1) & self.next_u32()
+    }
+
+    fn random_elem(&mut self) -> F::Elem {
+        F::Elem::random(self)
+    }
+
+    fn random_ext_elem(&mut self) -> F::ExtElem {
+        F::ExtElem::random(self)
+    }
+}
+
+struct PaddedSha256RngFactory;
+
+impl<F: Field> RngFactory<F> for PaddedSha256RngFactory {
+    fn new_rng(&self) -> Box<dyn Rng<F>> {
+        Box::new(PaddedShaRng::new())
+    }
+}
+
+/// A [HashSuite] using padded, standards-compliant SHA-256.
+pub struct PaddedSha256HashSuite<F: Field> {
+    phantom: PhantomData<F>,
+}
+
+impl<F: Field> PaddedSha256HashSuite<F> {
+    /// Construct a [PaddedSha256HashSuite].
+    pub fn new_suite() -> HashSuite<F> {
+        use alloc::rc::Rc;
+        HashSuite {
+            name: SHA256_PADDED.into(),
+            hashfn: Rc::new(PaddedSha256HashFn {}),
+            rng: Rc::new(PaddedSha256RngFactory {}),
+        }
+    }
+}
