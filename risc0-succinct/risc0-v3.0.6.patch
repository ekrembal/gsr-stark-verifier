+fn gsr_verify_file() {
+    use crate::receipt::merkle::MerkleProof;
+    let path = std::env::var("R0_GSR_RECEIPT").unwrap();
+    let v: serde_json::Value = serde_json::from_str(&std::fs::read_to_string(path).unwrap()).unwrap();
+    let seal_bytes = std::fs::read(std::env::var("R0_GSR_SEAL").unwrap()).unwrap();
+    let digest = |x: &serde_json::Value| -> Digest { hex::FromHex::from_hex(x.as_str().unwrap()).unwrap() };
+    let result = (|| -> Result<(), String> {
+        if seal_bytes.len() % 4 != 0 {
+            return Err("seal length not a multiple of 4".into());
+        }
+        let seal: Vec<u32> = seal_bytes
+            .chunks_exact(4)
+            .map(|c| u32::from_le_bytes(c.try_into().unwrap()))
+            .collect();
+        let info = |x: &serde_json::Value| {
+            risc0_zkp::adapter::ProtocolInfo(x.as_str().unwrap().as_bytes().try_into().unwrap())
+        };
+        let params = SuccinctReceiptVerifierParameters {
+            control_root: digest(&v["control_root"]),
+            inner_control_root: v["inner_control_root"].as_str().map(|s| hex::FromHex::from_hex(s).unwrap()),
+            proof_system_info: info(&v["proof_system_info"]),
+            circuit_info: info(&v["circuit_info"]),
+        };
+        let proof = &v["control_inclusion_proof"];
+        let receipt = SuccinctReceipt::<ReceiptClaim> {
+            seal,
+            hashfn: v["hashfn"].as_str().unwrap().to_string(),
+            control_id: digest(&v["control_id"]),
+            control_inclusion_proof: MerkleProof {
+                index: proof["index"].as_u64().unwrap() as u32,
+                digests: proof["digests"].as_array().unwrap().iter().map(digest).collect(),
+            },
+            claim: MaybePruned::Pruned(digest(&v["claim_digest"])),
+            verifier_parameters: params.digest(),
+        };
+        let ctx = VerifierContext::empty()
+            .with_suites(VerifierContext::default_hash_suites())
+            .with_succinct_verifier_parameters(params);
+        receipt.verify_integrity_with_context(&ctx).map_err(|e| format!("{e:?}"))
+    })();
+    match result {
+        Ok(()) => println!("NATIVE_OK"),
+        Err(e) => println!("NATIVE_ERR {e}"),
+    }
+}
+
+/// Re-prove the final recursion layer of `inner` with the identity program under hash suite `name`, returning
+/// the succinct receipt and the verifier parameters for a control tree holding only that identity program.
+fn gsr_identity(
+    inner: &SuccinctReceipt<ReceiptClaim>,
+    name: &str,
+) -> (SuccinctReceipt<ReceiptClaim>, SuccinctReceiptVerifierParameters) {
+    let (_, control_id) = zkr::identity(name).unwrap();
+    let opts = ProverOpts::succinct()
+        .with_hashfn(name.to_string())
+        .with_control_ids(vec![control_id]);
+    let mut prover = Prover::new_identity(inner, opts.clone()).unwrap();
+    let recursion_receipt = prover.run().unwrap();
+
+    let hashfn = opts.hash_suite().unwrap().hashfn;
+    let control_tree = MerkleGroup::new(opts.control_ids.clone()).unwrap();
+    let params = SuccinctReceiptVerifierParameters {
+        control_root: control_tree.calc_root(hashfn.as_ref()),
+        inner_control_root: Some(ALLOWED_CONTROL_ROOT),
+        proof_system_info: PROOF_SYSTEM_INFO,
+        circuit_info: CircuitImpl::CIRCUIT_INFO,
+    };
+    let receipt = SuccinctReceipt {
+        seal: recursion_receipt.seal,
+        hashfn: opts.hashfn,
+        control_id,
+        control_inclusion_proof: control_tree
+            .get_proof(&control_id, hashfn.as_ref())
+            .unwrap(),
+        claim: inner.claim.clone(),
+        verifier_parameters: params.digest(),
+    };
+    (receipt, params)
+}
+
+/// Prove the `gsr_covenant` guest with secret `R0_GSR_COVENANT_SECRET` and transaction outputs
+/// `R0_GSR_COVENANT_OUTPUTS` (both hex) down to a `sha-256-padded` succinct receipt, verify it natively and
+/// write `covenant-receipt.json` / `covenant-seal.bin` to `R0_GSR_SEAL_DIR`.
+#[test]
+#[ignore]
+fn gsr_covenant_prove() {
+    let hex_var = |k: &str| hex::decode(std::env::var(k).unwrap()).unwrap();
+    let (secret, outputs) = (hex_var("R0_GSR_COVENANT_SECRET"), hex_var("R0_GSR_COVENANT_OUTPUTS"));
+    let env = ExecutorEnv::builder()
+        .write(&secret)
+        .unwrap()
+        .write(&outputs)
+        .unwrap()
+        .build()
+        .unwrap();
+    let session = execute_elf(env, GSR_COVENANT_ELF).unwrap();
+    let journal = session.journal.clone().unwrap();
+    assert_eq!(journal.bytes, outputs);
+
+    let segments = prove_segments(&session).unwrap();
+    let mut compressed = lift(&segments[0]).unwrap();
+    for receipt in &segments[1..] {
+        compressed = join(&compressed, &lift(receipt).unwrap()).unwrap();
+    }
+    let (receipt, params) = gsr_identity(&compressed, "sha-256-padded");
+    let claim = receipt.claim.as_value().unwrap();
+    assert_eq!(claim.pre.digest(), Digest::from(GSR_COVENANT_ID));
+
+    let ctx = VerifierContext::empty()
+        .with_suites(VerifierContext::default_hash_suites())
+        .with_succinct_verifier_parameters(params.clone());
+    receipt.verify_integrity_with_context(&ctx).unwrap();
+    Receipt::new(InnerReceipt::Succinct(receipt.clone()), journal.bytes.clone())
+        .verify_with_context(&ctx, GSR_COVENANT_ID)
+        .unwrap();
+
+    let dir = std::env::var("R0_GSR_SEAL_DIR").unwrap();
+    std::fs::write(
+        format!("{dir}/covenant-seal.bin"),
+        bytemuck::cast_slice::<u32, u8>(&receipt.seal),
+    )
+    .unwrap();
+    std::fs::write(
+        format!("{dir}/covenant-receipt.json"),
+        serde_json::to_string_pretty(&gsr_receipt_json(&receipt, &params, &journal.bytes)).unwrap(),
+    )
+    .unwrap();
+    println!("covenant image id : {}", Digest::from(GSR_COVENANT_ID));
+    println!("covenant claim    : {}", receipt.claim.digest());
+}
