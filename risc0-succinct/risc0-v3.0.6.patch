+/// GSR cost research: the padded suite must produce digests a plain SHA-256 (Bitcoin Script's
+/// `OP_SHA256`) reproduces, unlike the stock "sha-256" suite's bare compression function.
+#[test_log::test]
+fn gsr_padded_sha_matches_fips() {
+    use risc0_zkp::core::{
+        digest::Digest,
+        hash::{hash_suite_from_name, sha::Impl as ShaImpl, sha::Sha256 as _},
+    };
+
+    // Anchor Impl::hash_bytes to the FIPS 180-4 test vector for "abc".
+    assert_eq!(
+        ShaImpl::hash_bytes(b"abc").as_bytes(),
+        hex::decode("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
+            .unwrap()
+            .as_slice()
+    );
+
+    let padded = hash_suite_from_name("sha-256-padded").unwrap();
+    let stock = hash_suite_from_name("sha-256").unwrap();
+    let a = Digest::from([1u32, 2, 3, 4, 5, 6, 7, 8]);
+    let b = Digest::from([9u32, 10, 11, 12, 13, 14, 15, 16]);
+
+    let mut preimage = a.as_bytes().to_vec();
+    preimage.extend_from_slice(b.as_bytes());
+    assert_eq!(
+        padded.hashfn.hash_pair(&a, &b).as_bytes(),
+        ShaImpl::hash_bytes(&preimage).as_bytes()
+    );
+    assert_ne!(
+        stock.hashfn.hash_pair(&a, &b).as_bytes(),
+        ShaImpl::hash_bytes(&preimage).as_bytes()
+    );
+
+    let elems: Vec<BabyBearElem> = (0..37u32).map(BabyBearElem::new).collect();
+    assert_eq!(
+        padded.hashfn.hash_elem_slice(&elems).as_bytes(),
+        ShaImpl::hash_bytes(bytemuck::cast_slice::<_, u8>(&elems)).as_bytes()
+    );
+}
