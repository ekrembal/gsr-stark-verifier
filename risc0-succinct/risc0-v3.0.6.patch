+        [
+            SHA_PAIR.load(Ordering::Relaxed),
+            SHA_SLICE.load(Ordering::Relaxed),
+            SHA_SLICE_BYTES.load(Ordering::Relaxed),
+            P2_PERMUTE.load(Ordering::Relaxed),
+        ]
+    }
+
+    pub(crate) fn bump(counter: &AtomicU64, by: u64) {
+        counter.fetch_add(by, Ordering::Relaxed);
+    }
+}
