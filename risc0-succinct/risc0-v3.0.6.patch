+//! GSR cost research: field operation counters, split by verifier phase.
+//!
+//! Counts BabyBear base and extension field operations so a Bitcoin Script (GSR) verifier can be
+//! priced. Extension operations are implemented in terms of base operations, so the base counters
+//! already include the work done inside extension operations; the extension counters are reported
+//! separately only to show the shape of the arithmetic.
+//!
+//! Counting is off by default: incrementing shared atomics from every prover thread is far too
+//! contended to leave on during proving. Call [`enable`] around the code being measured.
+
+#[cfg(not(target_os = "zkvm"))]
+use core::sync::atomic::{AtomicBool, AtomicU64, AtomicUsize, Ordering};
+
+/// Operation counter names, in index order.
+pub const OPS: &[&str] = &[
+    "base_mul",
+    "base_add",
+    "base_sub",
+    "ext_mul",
+    "ext_mul_base",
+    "ext_add",
+    "ext_sub",
+    "ext_inv",
+];
+
+/// Index of the base field multiplication counter.
+pub const BASE_MUL: usize = 0;
+/// Index of the base field addition counter.
+pub const BASE_ADD: usize = 1;
+/// Index of the base field subtraction counter.
+pub const BASE_SUB: usize = 2;
+/// Index of the extension field multiplication counter.
+pub const EXT_MUL: usize = 3;
+/// Index of the extension-by-base field multiplication counter.
+pub const EXT_MUL_BASE: usize = 4;
+/// Index of the extension field addition counter.
+pub const EXT_ADD: usize = 5;
+/// Index of the extension field subtraction counter.
+pub const EXT_SUB: usize = 6;
+/// Index of the extension field inversion counter.
+pub const EXT_INV: usize = 7;
+
+/// Verifier phase names, in index order.
+pub const PHASES: &[&str] = &["other", "constraint_eval", "fri_fold", "deep_ali"];
+
+/// Phase covering everything that is not separately attributed.
+pub const PHASE_OTHER: usize = 0;
+/// Phase covering the one-shot DEEP-ALI constraint (validity polynomial) evaluation.
+pub const PHASE_CONSTRAINT_EVAL: usize = 1;
+/// Phase covering FRI folding: the per-round NTT interpolation and evaluation.
+pub const PHASE_FRI: usize = 2;
+/// Phase covering the per-query DEEP-ALI evaluation of the tap columns.
+pub const PHASE_DEEP_ALI: usize = 3;
+
+#[cfg(not(target_os = "zkvm"))]
+const NUM_COUNTERS: usize = 4 * 8;
+
+#[cfg(not(target_os = "zkvm"))]
+#[allow(clippy::declare_interior_mutable_const)]
+const ZERO: AtomicU64 = AtomicU64::new(0);
+
+/// Counters, indexed by `phase * OPS.len() + op`.
+#[cfg(not(target_os = "zkvm"))]
+pub static COUNTS: [AtomicU64; NUM_COUNTERS] = [ZERO; NUM_COUNTERS];
+
+#[cfg(not(target_os = "zkvm"))]
+static ENABLED: AtomicBool = AtomicBool::new(false);
+
+#[cfg(not(target_os = "zkvm"))]
+static PHASE: AtomicUsize = AtomicUsize::new(PHASE_OTHER);
+
+/// Increment an operation counter for the current phase, if counting is enabled.
+#[cfg(not(target_os = "zkvm"))]
+#[inline(always)]
+pub fn bump(op: usize) {
+    if ENABLED.load(Ordering::Relaxed) {
+        COUNTS[PHASE.load(Ordering::Relaxed) * OPS.len() + op].fetch_add(1, Ordering::Relaxed);
+    }
+}
+
+/// Turn counting on or off.
+#[cfg(not(target_os = "zkvm"))]
+pub fn enable(on: bool) {
+    ENABLED.store(on, Ordering::Relaxed);
+}
+
+/// Attribute subsequent operations to `phase`, returning the previous phase.
+#[cfg(not(target_os = "zkvm"))]
+pub fn set_phase(phase: usize) -> usize {
+    PHASE.swap(phase, Ordering::Relaxed)
+}
+
+/// A snapshot of every counter, indexed by `phase * OPS.len() + op`.
+#[cfg(not(target_os = "zkvm"))]
+pub fn snapshot() -> [u64; NUM_COUNTERS] {
+    core::array::from_fn(|i| COUNTS[i].load(Ordering::Relaxed))
+}
+
+/// Counting is not available inside the guest, where there is nothing to measure.
+#[cfg(target_os = "zkvm")]
+pub fn set_phase(_phase: usize) -> usize {
+    PHASE_OTHER
+}
