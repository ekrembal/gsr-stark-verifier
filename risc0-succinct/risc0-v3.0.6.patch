+//! GSR covenant demo: authorizes a Bitcoin spend by proving knowledge of a SHA-256 preimage.
+//!
+//! The journal is the spending transaction's outputs in BIP 341 serialization
+//! (`value: u64 LE || compact_size(len) || scriptPubKey` per output), so the journal digest equals the
+//! transaction's `sha_outputs`, which the Tapscript covenant binds through the signature hash.
+
+#![no_std]
+#![no_main]
+
+extern crate alloc;
+
+use alloc::vec::Vec;
+
+use risc0_zkvm::{
+    guest::env,
+    sha::{Impl, Sha256},
+};
+
+risc0_zkvm::entry!(main);
+
+/// SHA-256("gsr covenant demo secret").
+const LOCK: [u8; 32] =
+    hex_literal::hex!("10af5e6b28cf0f912dfedf2fd49946b8cd4ff90e47e94022154ce153dc2e7ad9");
+
+fn take<'a>(data: &'a [u8], pos: &mut usize, n: usize) -> &'a [u8] {
+    let end = pos.checked_add(n).expect("length overflow");
+    let out = data.get(*pos..end).expect("truncated outputs");
+    *pos = end;
+    out
+}
+
+fn compact_size(data: &[u8], pos: &mut usize) -> usize {
+    let n = match take(data, pos, 1)[0] {
+        0xfd => u16::from_le_bytes(take(data, pos, 2).try_into().unwrap()) as u64,
+        0xfe => u32::from_le_bytes(take(data, pos, 4).try_into().unwrap()) as u64,
+        0xff => u64::from_le_bytes(take(data, pos, 8).try_into().unwrap()),
+        n => n as u64,
+    };
+    usize::try_from(n).expect("length overflow")
+}
+
+fn main() {
+    let secret: Vec<u8> = env::read();
+    let outputs: Vec<u8> = env::read();
+    assert_eq!(Impl::hash_bytes(&secret).as_bytes(), &LOCK, "wrong secret");
+
+    let mut pos = 0;
+    let mut count = 0;
+    while pos < outputs.len() {
+        take(&outputs, &mut pos, 8);
+        let len = compact_size(&outputs, &mut pos);
+        take(&outputs, &mut pos, len);
+        count += 1;
+    }
+    assert!(count > 0, "no outputs");
+
+    env::commit_slice(&outputs);
+}
